#!/usr/bin/env bash
# Usage: verify-red <TICKET>
# Spec gate: judges .agent/reports/results/test.tsv (written by `make test` against the stubs) against
# specs/<TICKET>/tests.lock. Passes only when every locked test ID appears exactly once with status
# `failed` and a message containing "NotImplemented", i.e. it fails because the stub was called,
# not because of an import, syntax, fixture or assertion error.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
require_args 1 $# "verify-red <TICKET>"
cd_project_root

lock="specs/$1/tests.lock"
results=.agent/reports/results/test.tsv
[[ -s $lock ]] || die "$lock is missing or empty; run spec-lock"
[[ -f $results ]] || die "$results is missing; run 'make test'"

problems=$(awk -F'\t' '
  NR == FNR {
    if (NF == 0) next
    locked[$0] = 1
    order[++count] = $0
    next
  }
  ($1 in locked) { seen[$1]++; status[$1] = $2; message[$1] = $3 }
  END {
    for (i = 1; i <= count; i++) {
      id = order[i]
      if (!(id in seen)) printf "%s\tmissing\tno result; the test did not run or its process exited early\n", id
      else if (seen[id] > 1) printf "%s\tduplicate\t%d results for one ID\n", id, seen[id]
      else if (status[id] != "failed") printf "%s\t%s (expected failed)\t%s\n", id, status[id], message[id]
      else if (index(message[id], "NotImplemented") == 0) printf "%s\tfailed without NotImplemented\t%s\n", id, message[id]
    }
  }
' "$lock" "$results")

if [[ -n $problems ]]; then
  printf 'verify-red %s: FAILED\n%s\n' "$1" "$(printf 'ID\tPROBLEM\tDETAIL\n%s\n' "$problems" | column -t -s $'\t')" >&2
  exit 1
fi
printf 'verify-red %s: all %s locked tests fail on NotImplemented\n' "$1" "$(awk 'NF' "$lock" | wc -l | tr -d ' ')"
