#!/usr/bin/env bash
# Usage: mutants-mutmut-run
# Runs mutmut 3 on the Python files of the mutation scope (see mutants-scope) in a scratch copy of the
# project (.agent/reports/mutation/mutmut), so mutmut's `mutants/` tree never lands in the repository.
# The configuration is the kit's: the copy's pyproject.toml gets the kit's [tool.mutmut] table in place
# of the project's (mutmut reads no other source once that table exists), checked before the run with the
# parser mutmut itself reads pyproject.toml with (tomllib from Python 3.11, the toml package before), and
# the installed mutmut must read every key of it: mutmut 3.3.1, the newest for Python 3.9, reads none and
# would run every test without the integrity guard. Only the locked test files run (a kill must come from a
# locked test), with the integrity guard and a fixed Hypothesis seed.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
source "$(dirname "$0")/mutants-lib.sh"
require_args 0 $# "mutants-mutmut-run"
cd_project_root

root=$(pwd -P)
work="$MUTATION_DIR/mutmut"
files=$(scope_files '\.py$')
[[ -n $files ]] || die "no Python files in $MUTATION_SCOPE"
tests=$(for lock in specs/*/tests.lock; do [[ -f $lock ]] && awk -F'::' 'NF { print $1 }' "$lock"; done | sort -u)
[[ -n $tests ]] || die "no locked tests (specs/*/tests.lock); mutants can only be killed by locked tests"

rm -rf "$work"
mkdir -p "$work"
git ls-files -co --exclude-standard | grep -v '^\.agent/' | while IFS= read -r path; do
  [[ -f $path ]] || continue
  mkdir -p "$work/$(dirname "$path")"
  cp "$path" "$work/$path"
done

config=$(jq -cn --argjson only "$(jq -R . <<<"$files" | jq -cs .)" --argjson tests "$(jq -R . <<<"$tests" | jq -cs .)" \
  --argjson sources "$(cut -d/ -f1 <<<"$files" | sort -u | jq -R . | jq -cs .)" '{
    source_paths: $sources,
    only_mutate: $only,
    pytest_add_cli_args_test_selection: $tests,
    pytest_add_cli_args: ["-p", "no:cacheprovider", "-p", "pytest_integrity", "--hypothesis-seed=20261105"],
    use_git_change_detection: false,
    timeout_multiplier: 10.0
  }')

# Replace any [tool.mutmut] table (and its subtables) of the copy with the kit's.
[[ -f "$work/pyproject.toml" ]] || die "pyproject.toml is missing; mutmut needs the project's pytest configuration"
awk '
  /^[[:space:]]*\[/ { skipping = ($0 ~ /^[[:space:]]*\[[[:space:]]*tool\.mutmut[[:space:]]*(\]|\.)/) }
  !skipping { print }
' "$work/pyproject.toml" >"$work/pyproject.toml.tmp"
{
  cat "$work/pyproject.toml.tmp"
  printf '\n[tool.mutmut]\n'
  jq -r 'to_entries[] | "\(.key) = \(.value | tojson)"' <<<"$config"
} >"$work/pyproject.toml"
rm "$work/pyproject.toml.tmp"

cd "$work"
uv run -q --project "$root" python -c '
import json, pathlib, sys
from importlib.util import find_spec
if sys.version_info >= (3, 11):
    from tomllib import loads
else:
    from toml import loads
expected = json.loads(sys.argv[1])
with open("pyproject.toml", encoding="utf-8") as handle:
    actual = loads(handle.read()).get("tool", {}).get("mutmut")
if actual != expected:
    raise SystemExit(f"mutmut configuration of the scratch copy is not the kit configuration: {actual!r}")
spec = find_spec("mutmut")
if spec is None or spec.origin is None:
    raise SystemExit("mutmut is not installed in the project (uv add --dev mutmut)")
source = "".join(path.read_text(encoding="utf-8") for path in pathlib.Path(spec.origin).parent.rglob("*.py"))
unread = [key for key in expected if json.dumps(key) not in source and repr(key) not in source]
if unread:
    raise SystemExit(f"the installed mutmut does not read {unread} from [tool.mutmut], so it would mutate and test "
                     "without the kit settings; the mutation gate needs mutmut 3.8 or newer, which needs Python 3.10")
' "$config"
PYTHONPATH="$root/.agent/test-support" uv run -q --project "$root" mutmut run --max-children 4
