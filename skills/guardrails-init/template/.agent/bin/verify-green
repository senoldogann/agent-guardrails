#!/usr/bin/env bash
# Usage: verify-green <TICKET>
# Judges .agent/reports/results/test.tsv (written by `make test`) against specs/<TICKET>/tests.lock.
# Passes only when every locked test ID appears exactly once with status `passed` and no result in
# the file (locked or not) is `skipped` or `error`. Exit codes are not evidence: the results are.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
require_args 1 $# "verify-green <TICKET>"
cd_project_root

lock="specs/$1/tests.lock"
results=.agent/reports/results/test.tsv
[[ -s $lock ]] || die "$lock is missing or empty; run spec-lock"
[[ -f $results ]] || die "$results is missing; run 'make test'"

problems=$(awk -F'\t' '
  NR == FNR {
    if (NF == 0) next
    locked[$0] = 1
    order[++count] = $0
    next
  }
  NF != 3 || ($2 != "passed" && $2 != "failed" && $2 != "skipped" && $2 != "error") {
    printf "%s\tmalformed result line %d\t%s\n", $1, FNR, $0
    next
  }
  {
    seen[$1]++
    status[$1] = $2
    message[$1] = $3
    if (!($1 in locked) && ($2 == "skipped" || $2 == "error")) printf "%s\t%s (not locked)\t%s\n", $1, $2, $3
  }
  END {
    for (i = 1; i <= count; i++) {
      id = order[i]
      if (!(id in seen)) printf "%s\tmissing\tno result; the test did not run or its process exited early\n", id
      else if (seen[id] > 1) printf "%s\tduplicate\t%d results for one ID\n", id, seen[id]
      else if (status[id] != "passed") printf "%s\t%s\t%s\n", id, status[id], message[id]
    }
  }
' "$lock" "$results")

if [[ -n $problems ]]; then
  printf 'verify-green %s: FAILED\n%s\n' "$1" "$(printf 'ID\tPROBLEM\tDETAIL\n%s\n' "$problems" | column -t -s $'\t')" >&2
  exit 1
fi
printf 'verify-green %s: all %s locked tests passed; no skipped or errored tests\n' "$1" "$(awk 'NF' "$lock" | wc -l | tr -d ' ')"
