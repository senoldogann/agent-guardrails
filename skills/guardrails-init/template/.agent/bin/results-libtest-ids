#!/usr/bin/env bash
# Usage: results-libtest-ids <cargo-list-output.txt>
# Prints normalized test IDs from `cargo test --tests -- --list` output with stderr merged in
# (see results-lib.sh). The file part is the target's source file from cargo's "Running" line
# (src/lib.rs for unit tests, tests/<name>.rs for integration tests); module paths become " > ".
set -euo pipefail
source "$(dirname "$0")/lib.sh"
source "$(dirname "$0")/results-lib.sh"
require_args 1 $# "results-libtest-ids <cargo-list-output.txt>"
cd_project_root
require_report "$1"

awk '
  /^[[:space:]]+Running / {
    file = $0
    sub(/^[[:space:]]+Running (unittests )?/, "", file)
    sub(/ \(.*$/, "", file)
    next
  }
  file != "" && /: test$/ {
    name = substr($0, 1, length($0) - length(": test"))
    gsub(/::/, " > ", name)
    print file "::" name
  }
' "$1" | print_unique_ids
