#!/usr/bin/env bash
# Usage: mutation-scope <base-commit>
# Writes .agent/reports/mutation/scope.txt: the non-test source files this branch changed since
# <base-commit> that still exist (one repo-relative path per line). Human-owned paths (tests, configs,
# specs, dot directories) are never mutated. The list is computed here, never read from a project config,
# so a pull request cannot shrink what gets mutated.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
require_args 1 $# "mutation-scope <base-commit>"
cd_project_root

base=$1
out=.agent/reports/mutation/scope.txt
mkdir -p "$(dirname "$out")"
: >"$out"

while IFS= read -r -d '' path; do
  [[ -f $path ]] || continue
  is_human_owned "$path" && continue
  case $path in
    *.ts | *.tsx | *.mts | *.cts | *.js | *.jsx | *.mjs | *.cjs | *.py | *.rs) printf '%s\n' "$path" >>"$out" ;;
  esac
done < <(git diff -z --name-only --no-renames "$base...HEAD")

count=$(wc -l <"$out" | tr -d ' ')
printf 'mutation scope: %s file(s)\n' "$count"
[[ $count -eq 0 ]] || sed 's/^/  /' "$out"
