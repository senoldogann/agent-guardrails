#!/usr/bin/env bash
# Usage: setup-github <owner-login>
# Run by the HUMAN owner (the agent's bash-guard blocks these API calls). Applies, via gh api:
#   - environment "merge-approval": <owner-login> as required reviewer, deployments only from the
#     default branch (admin bypass cannot be set via the API: the script prints the manual step)
#   - ruleset "agent-guardrails" on the default branch: required check runs `guard`,
#     `merge-approval` and every `checks-<lang>` job in .github/workflows/checks-*.yml, squash only,
#     linear history, no force-push/deletion, no bypass actors
#   - repo settings: squash merge only, auto-merge on, delete branch on merge
#   - Actions: default token read-only, Actions may not create or approve PRs, actions pinned to SHAs
# Idempotent for the environment and settings; the ruleset is created or updated by name.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
require_args 1 $# "setup-github <owner-login>"
cd_project_root

owner_login=$1
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
default_branch=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)
owner_id=$(gh api "users/$owner_login" --jq .id)
printf 'repo %s, default branch %s, approver %s (%s)\n' "$repo" "$default_branch" "$owner_login" "$owner_id"

jq -n --argjson id "$owner_id" '{
  reviewers: [{type: "User", id: $id}],
  prevent_self_review: false,
  deployment_branch_policy: {protected_branches: false, custom_branch_policies: true}
}' | gh api -X PUT "repos/$repo/environments/merge-approval" --input - >/dev/null
existing_policies=$(gh api "repos/$repo/environments/merge-approval/deployment-branch-policies" --jq '.branch_policies[].name')
if ! grep -xF -- "$default_branch" <<<"$existing_policies" >/dev/null; then
  gh api -X POST "repos/$repo/environments/merge-approval/deployment-branch-policies" \
    -f name="$default_branch" -f type=branch >/dev/null
fi
printf 'environment merge-approval: ok\n'

check_jobs=$(sed -nE 's/^  (checks-[a-z]+):$/\1/p' .github/workflows/checks-*.yml | sort -u)
[[ -n $check_jobs ]] || die "no checks-<lang> job found in .github/workflows/checks-*.yml"
required=$(jq -n --arg jobs "$check_jobs" '["guard", "merge-approval"] + ($jobs | split("\n") | map(select(length > 0)))
  | map({context: ., integration_id: 15368})')

ruleset=$(jq -n --argjson required "$required" '{
  name: "agent-guardrails", target: "branch", enforcement: "active", bypass_actors: [],
  conditions: {ref_name: {include: ["~DEFAULT_BRANCH"], exclude: []}},
  rules: [
    {type: "deletion"}, {type: "non_fast_forward"}, {type: "required_linear_history"},
    {type: "pull_request", parameters: {
      required_approving_review_count: 0, require_code_owner_review: false,
      dismiss_stale_reviews_on_push: false, require_last_push_approval: false,
      required_review_thread_resolution: true, allowed_merge_methods: ["squash"]}},
    {type: "required_status_checks", parameters: {
      strict_required_status_checks_policy: false,
      required_status_checks: $required}}
  ]}')
ruleset_id=$(gh api "repos/$repo/rulesets" --jq '.[] | select(.name == "agent-guardrails") | .id')
if [[ -n $ruleset_id ]]; then
  gh api -X PUT "repos/$repo/rulesets/$ruleset_id" --input - <<<"$ruleset" >/dev/null
else
  gh api -X POST "repos/$repo/rulesets" --input - <<<"$ruleset" >/dev/null
fi
printf 'ruleset agent-guardrails: ok\n'

gh api -X PATCH "repos/$repo" -F allow_squash_merge=true -F allow_merge_commit=false \
  -F allow_rebase_merge=false -F allow_auto_merge=true -F delete_branch_on_merge=true >/dev/null
gh api -X PUT "repos/$repo/actions/permissions/workflow" \
  -f default_workflow_permissions=read -F can_approve_pull_request_reviews=false >/dev/null
gh api -X PUT "repos/$repo/actions/permissions" \
  -F enabled=true -f allowed_actions=all -F sha_pinning_required=true >/dev/null
printf 'repository and Actions settings: ok\n'
cat <<EOF_MANUAL
Manual steps (not settable through the API):
  1. Settings → Environments → merge-approval → untick "Allow administrators to bypass configured
     protection rules".
  2. Create the agent's fine-grained token (see AGENTS.md "Agent identity"), use an HTTPS remote and
     run 'gh auth setup-git' so git pushes with that token instead of your SSH key.
EOF_MANUAL
