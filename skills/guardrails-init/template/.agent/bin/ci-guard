#!/usr/bin/env bash
# Usage: ci-guard <base-commit> <head-ref> <head-branch-name> <default-branch> <pr-base-branch>
# Runs from the DEFAULT branch checkout (pull_request_target) and only reads the PR through git,
# so a PR cannot weaken the guard that judges it. Every PR is merged only after a human approves
# its exact HEAD (commit status merge-approval); this guard makes that review safe and focused:
#   hard failures  - PR not targeting the default branch, merge commits, symlinks/submodules,
#                    dependency/vendor directories, broken spec locks, ambiguous or invalid tickets,
#                    write-allow patterns that reach guarded paths, workflow files that could stand
#                    in for a required check or post statuses
#   review summary - head SHA, ticket, accepted mutants and security findings, and every human-owned
#                    path the PR changes
# The checks it shares with ci-guard-group (a merge queue's group commit) live in guard-lib.sh.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
source "$(dirname "$0")/guard-lib.sh"
require_args 5 $# "ci-guard <base-commit> <head-ref> <head-branch-name> <default-branch> <pr-base-branch>"
cd_project_root

base=$1
head=$2
branch=$3
default_branch=$4
pr_base=$5
[[ $pr_base == "$default_branch" ]] || fail "PR targets '$pr_base'; only the default branch '$default_branch' is supported"

guard_no_merges "$base" "$head"
guard_changed_files "$base" "$head"
# The guard workflow itself only runs from the default branch (pull_request_target, and merge_group judged
# with the default branch's guard), so its trigger may not change (guard_trigger_problems).
guard_workflows "$head"

# Tickets touched by this PR.
tickets=$(guard_touched_tickets)
ticket_count=$(awk 'NF > 0' <<<"$tickets" | wc -l | tr -d ' ')
if [[ $ticket_count -gt 1 ]]; then
  fail "PR touches several tickets: $(tr '\n' ' ' <<<"$tickets")"
elif [[ $ticket_count -eq 1 ]]; then
  ticket=$tickets
  [[ $branch == *"/$ticket-"* || $branch == *"/$ticket" ]] || fail "branch '$branch' does not name ticket $ticket"
  guard_ticket_spec "$ticket" "$head"
fi

guard_locks "$head"

# Spec commits: HEAD must not be one (tests are red there by design), and amendments are made visible.
spec_commits=$(git rev-list "$base..$head" -- 'specs/*/spec.lock')
if [[ -n $spec_commits && $(head -n 1 <<<"$spec_commits") == "$(git rev-parse "$head")" ]]; then
  fail "HEAD is a spec commit (locked tests are red by design); implement the ticket before merging"
fi
spec_count=$(awk 'NF' <<<"$spec_commits" | wc -l | tr -d ' ')

printf '\nhead: %s\n' "$(git rev-parse "$head")"
printf 'ticket: %s\n' "${ticket:-none}"
if [[ $spec_count -gt 1 ]]; then
  first=$(tail -n 1 <<<"$spec_commits")
  last=$(head -n 1 <<<"$spec_commits")
  printf 'SPEC AMENDED: locked %s times in this PR; locked/spec files changed between first and last lock:\n' "$spec_count"
  amended_paths=(specs)
  while IFS= read -r path; do
    amended_paths+=("$path")
  done < <(git show "$last:specs/${ticket:-}/locked-files" | awk 'NF && $0 !~ /^#/')
  git diff --stat "$first" "$last" -- "${amended_paths[@]}"
fi
guard_review_summary "$base" "$head"
exit "$guard_status"
