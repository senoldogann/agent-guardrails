#!/usr/bin/env bash
# Usage: run-checks <log-file> <make-target>...
# Runs every target (even after a failure), records each command, its output and its
# exit code in <log-file>, prints a summary, and exits 1 if any target failed.
# The log starts with HEAD and a working-tree snapshot so a report can prove it is not stale.
# Local logs are agent feedback; the CI run of the PR is the evidence of record.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
[[ $# -ge 2 ]] || die "usage: run-checks <log-file> <make-target>..."
cd_project_root

log=$1
shift
mkdir -p "$(dirname "$log")"
printf 'head: %s\nsnapshot: %s\n' "$(git rev-parse HEAD)" "$(worktree_snapshot)" | tee "$log"

failed=""
for target in "$@"; do
  printf '\n$ make %s\n' "$target" | tee -a "$log"
  if make --no-print-directory "$target" 2>&1 | tee -a "$log"; then
    code=0
  else
    code=$?
  fi
  printf '[exit %d]\n' "$code" | tee -a "$log"
  [[ $code -eq 0 ]] || failed+=" $target"
done

if [[ -n $failed ]]; then
  printf '\nFAILED:%s\n' "$failed" | tee -a "$log"
  exit 1
fi
printf '\nALL PASSED: %s\n' "$*" | tee -a "$log"
