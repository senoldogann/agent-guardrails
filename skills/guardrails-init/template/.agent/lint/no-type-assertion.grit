// Biome plugin: bans type assertions (`x as T`, `<T>x`) except `as const`.

language js

or {
  TsAsExpression(ty=$type) as $node where {
    not $type <: r"const",
    register_diagnostic(span=$node, message="Type assertions are banned; narrow with a smart constructor or type guard.", severity="error")
  },
  TsTypeAssertionExpression() as $node where {
    register_diagnostic(span=$node, message="Type assertions are banned; narrow with a smart constructor or type guard.", severity="error")
  }
}
