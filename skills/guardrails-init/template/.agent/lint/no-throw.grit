// Biome plugin: implementation code returns typed results. The only `throw` allowed is a stub's
// `throw new Error("NotImplemented: <name>")`. A condition that can never fail but must narrow a type
// goes through the kit helper `invariant(<condition>, "Invariant: <what must hold>")` instead
// (.agent/runtime/invariant.ts), which mutation runs turn into a no-op so it cannot kill mutants.

language js

`throw $error` as $node where {
  not $error <: `new Error($message)` where { $message <: r"^[\"'`]NotImplemented: .*" },
  register_diagnostic(span=$node, message="`throw` is banned in implementation code (contracts return typed results); only a stub may throw new Error('NotImplemented: <name>'). Use invariant(<condition>, 'Invariant: ...') from .agent/runtime/invariant for a check that can never fail.", severity="error")
}
