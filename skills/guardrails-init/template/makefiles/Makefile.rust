# Command contract for agents and CI. Language targets here; shared gates in .agent/common.mk.
# Prerequisites: bash, GNU-compatible make, jq, cargo with clippy and rustfmt.
# Dev dependencies: cargo add --dev proptest; tool: cargo install --locked cargo-mutants@27.1.0; Cargo.toml: [lints.rust] unsafe_code = "forbid".
# Test results are judged from the normalized files in $(RESULTS), never from exit codes alone.
# Tests run under plain libtest (one process per test binary), not nextest: a test that exits the
# process then drops the remaining results instead of being reported as passed.
include .agent/common.mk

RESULTS := .agent/reports/results
# The results adapters parse libtest text, so cargo never colours it (CI toolchain actions set CARGO_TERM_COLOR=always).
export CARGO_TERM_COLOR := never
CLIPPY := CLIPPY_CONF_DIR=.agent/lint cargo clippy
# MUTATION_RUN=1 (set by the mutation tools) fixes the proptest seed so mutants are judged the same way every run.
PROPTEST_SEED := $(if $(MUTATION_RUN),PROPTEST_RNG_SEED=20261105,)

.PHONY: typecheck lint fmt-check test-ids test test-prop test-mutation

typecheck:
	cargo check --locked --all-targets

## Clippy with the kit's clippy.toml (disallowed process exit/abort, env and panic-hook mutation), then
## the library alone without panics: contracts return Result; only a stub may todo!("NotImplemented: ...").
lint:
	$(CLIPPY) --locked --all-targets -- -D warnings
	$(CLIPPY) --locked --lib -- -D warnings -D clippy::panic -D clippy::unwrap_used -D clippy::expect_used \
		-D clippy::unreachable -D clippy::unimplemented
	.agent/bin/escape-check rs .

fmt-check:
	cargo fmt --check

## Every test ID (unit and integration test targets) without running tests; stdout carries only IDs.
test-ids:
	@mkdir -p $(RESULTS)
	@cargo test --locked --tests -- --list >$(RESULTS)/ids.libtest.txt 2>&1 || { cat $(RESULTS)/ids.libtest.txt >&2; exit 1; }
	@.agent/bin/results-libtest-ids $(RESULTS)/ids.libtest.txt

# $(call libtest_results,<name>,<cargo test target selection>): runs cargo test, writes
# $(RESULTS)/<name>.tsv, exits with cargo's exit code (or the adapter's).
define libtest_results
	@mkdir -p $(RESULTS) && rm -f $(RESULTS)/$(1).libtest.txt $(RESULTS)/$(1).tsv
	@status=0; $(PROPTEST_SEED) cargo test --locked --no-fail-fast $(2) >$(RESULTS)/$(1).libtest.txt 2>&1 || status=$$?; \
	cat $(RESULTS)/$(1).libtest.txt; \
	.agent/bin/results-libtest $(RESULTS)/$(1).libtest.txt >$(RESULTS)/$(1).tsv.tmp && \
	mv $(RESULTS)/$(1).tsv.tmp $(RESULTS)/$(1).tsv && exit $$status
endef

## Full suite (unit and integration test targets) -> $(RESULTS)/test.tsv.
test:
	$(call libtest_results,test,--tests)

## Property tests (proptest, tests/property.rs) -> $(RESULTS)/test-prop.tsv.
test-prop:
	$(call libtest_results,test-prop,--test property)

## Mutation gate inputs over the kit-computed scope (.agent/reports/mutation/scope.txt): cargo-mutants
## with the trusted configuration, running only the locked test targets, then the numeric-literal
## mutator (cargo-mutants never mutates numbers) -> $(RESULTS)/mutants.tsv. The gate judges it against
## specs/*/mutants-accepted.
test-mutation:
	@mkdir -p $(RESULTS) && rm -f $(RESULTS)/mutants.tsv
	@files=$$(.agent/bin/mutants-scope '\.rs$$'); \
	if [ -z "$$files" ]; then : >$(RESULTS)/mutants.tsv; echo "test-mutation: no files in scope"; exit 0; fi; \
	.agent/bin/mutants-cargo-run && \
	.agent/bin/mutants-cargo .agent/reports/mutation/mutants.out/outcomes.json >$(RESULTS)/mutants.tsv.tmp && \
	.agent/bin/mutants-literals '\.rs$$' >>$(RESULTS)/mutants.tsv.tmp && \
	mv $(RESULTS)/mutants.tsv.tmp $(RESULTS)/mutants.tsv
