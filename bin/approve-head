#!/usr/bin/env bash
# Usage: approve-head <pr-link-or-number>   (run by the HUMAN owner in their own terminal)
# With a PR link it works from any directory; a bare number uses the current directory's repository.
# Gives the owner's merge approval for the exact current HEAD of a PR by posting the commit status
# `merge-approval` = success. The ruleset requires that context, so a new push needs a new approval.
# Lives in the kit install directory, outside every project, so an agent cannot edit the copy you run.
# Refuses when GH_TOKEN/GITHUB_TOKEN is set (that is the agent's environment, whose token must not
# be able to write commit statuses) and when the PR is not ready: base must be the default branch,
# the `guard` check run for that SHA must have succeeded, no workflow may grant `statuses: write`.
set -euo pipefail
kit=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
source "$kit/skills/guardrails-init/template/.agent/bin/lib.sh"
source "$kit/bin/pr-target.sh"
require_args 1 $# "approve-head <pr-link-or-number>"

[[ -z ${GH_TOKEN:-} && -z ${GITHUB_TOKEN:-} ]] ||
  die "GH_TOKEN/GITHUB_TOKEN is set: this looks like the agent's environment. Run approve-head in your own shell."
[[ -t 0 ]] || die "approve-head needs an interactive terminal (typed confirmation)"
source "$kit/bin/guardrails-lib.sh"
require_reviewed_kit

read -r repo pr < <(pr_target "$1")
default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name)
pr_json=$(gh pr view "$pr" -R "$repo" --json headRefOid,baseRefName,title,url,isDraft)
sha=$(jq -r .headRefOid <<<"$pr_json")
base=$(jq -r .baseRefName <<<"$pr_json")

[[ $base == "$default_branch" ]] || die "PR #$pr targets '$base', not the default branch '$default_branch'"
[[ $(jq -r .isDraft <<<"$pr_json") == false ]] || die "PR #$pr is a draft"

ruleset_id=$(gh api "repos/$repo/rulesets" --jq '.[] | select(.name == "agent-guardrails" and .enforcement == "active") | .id')
required=""
if [[ -n $ruleset_id ]]; then
  required=$(gh api "repos/$repo/rulesets/$ruleset_id" \
    --jq '.rules[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context')
fi
grep -Fx merge-approval <<<"$required" >/dev/null ||
  die "the agent-guardrails ruleset on $repo is not active or does not require merge-approval, so an approval would not protect anything. Check the audit log, then restore it with: guardrails on $repo"

# The guard result comes from the run of the default branch's agent-guard.yml (pull_request_target), not
# from any check run named "guard": a workflow added by the PR could report a check run of that name.
guard=$(gh api "repos/$repo/actions/runs?head_sha=$sha&event=pull_request_target&per_page=100" \
  --jq '[.workflow_runs[] | select(.path == ".github/workflows/agent-guard.yml")] | sort_by(.created_at) | last | .conclusion // "missing"')
[[ $guard == success ]] || die "guard run for $sha is '$guard'; wait for it or fix the PR"

while IFS= read -r workflow; do
  [[ -n $workflow ]] || continue
  if gh api "repos/$repo/contents/$workflow?ref=$sha" --jq .content | base64 --decode |
    grep -Ei 'statuses:[[:space:]]*write|write-all' >/dev/null; then
    die "$workflow grants statuses: write (could forge merge-approval); refuse to approve"
  fi
done < <(gh api "repos/$repo/contents/.github/workflows?ref=$sha" --jq '.[] | select(.type == "file") | .path')

files=$(gh api --paginate "repos/$repo/pulls/$pr/files?per_page=100" --jq '.[].filename')
[[ -n $files ]] || die "could not list the files of PR #$pr"
# Titles are written by the agent: drop control characters so they cannot redraw the lines below.
printf '\nPR #%s %s\n%s\nhead: %s\n\nChanged files:\n' "$pr" "$(jq -r '.title | gsub("[[:cntrl:]]"; "?")' <<<"$pr_json")" \
  "$(jq -r .url <<<"$pr_json")" "$sha"
workflow_changes=""
while IFS= read -r file; do
  [[ -n $file ]] || continue
  marker="  "
  if is_human_owned "$file"; then marker="! "; fi
  case $file in .github/workflows/* | .github/actions/*)
    marker="!!"
    workflow_changes+="$file "
    ;;
  esac
  printf '%s %s\n' "$marker" "$file"
done <<<"$files"
printf '\n(! human-owned, !! workflow: can change what CI enforces)\n'

short=${sha:0:7}
read -r -p "Type $short to approve merging exactly this commit: " typed </dev/tty
[[ $typed == "$short" ]] || die "confirmation did not match; nothing approved"
if [[ -n $workflow_changes ]]; then
  read -r -p "Workflow files change ($workflow_changes). Type 'workflows' to confirm you reviewed them: " typed </dev/tty
  [[ $typed == workflows ]] || die "workflow confirmation missing; nothing approved"
fi

gh api -X POST "repos/$repo/statuses/$sha" -f state=success -f context=merge-approval \
  -f description="Approved by owner for PR #$pr" >/dev/null
printf 'merge-approval: success on %s (PR #%s)\n' "$sha" "$pr"
