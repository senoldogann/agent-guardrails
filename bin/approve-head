#!/usr/bin/env bash
# Usage: approve-head <pr-link-or-number>   (run by the HUMAN owner in their own terminal)
# With a PR link it works from any directory; a bare number uses the current directory's repository.
# Gives the owner's merge approval for the exact current HEAD of a PR. In status mode (the agent works with
# the owner's login) it posts the commit status `merge-approval` = success, which the ruleset requires. In
# review mode (the agent pushes as its App's bot) it submits an approving GitHub review pinned to that commit
# (commit_id), which the ruleset requires from a code owner; GitHub dismisses it when a push changes the PR.
# Either way a new push needs a new approval.
# Lives in the kit install directory, outside every project, so an agent cannot edit the copy you run.
# Refuses in the agent's environment (GH_TOKEN, GITHUB_TOKEN or GH_CONFIG_DIR set) and when the PR is not
# ready: base must be the default branch, the `guard` run for that SHA must have succeeded, no workflow may
# grant `statuses: write` or `checks: write`.
set -euo pipefail
kit=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
source "$kit/skills/guardrails-init/template/.agent/bin/lib.sh"
source "$kit/bin/pr-target.sh"
require_args 1 $# "approve-head <pr-link-or-number>"

[[ -z ${GH_TOKEN:-} && -z ${GITHUB_TOKEN:-} && -z ${GH_CONFIG_DIR:-} ]] ||
  die "GH_TOKEN, GITHUB_TOKEN or GH_CONFIG_DIR is set: this looks like the agent's environment. Run approve-head in your own shell."
[[ -t 0 ]] || die "approve-head needs an interactive terminal (typed confirmation)"
source "$kit/bin/guardrails-lib.sh"
require_reviewed_kit

read -r repo pr < <(pr_target "$1")
default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name)
pr_json=$(gh pr view "$pr" -R "$repo" --json headRefOid,baseRefName,title,url,isDraft,author)
sha=$(jq -r .headRefOid <<<"$pr_json")
base=$(jq -r .baseRefName <<<"$pr_json")

[[ $base == "$default_branch" ]] || die "PR #$pr targets '$base', not the default branch '$default_branch'"
[[ $(jq -r .isDraft <<<"$pr_json") == false ]] || die "PR #$pr is a draft"

# The approval must protect something: status mode needs the active branch ruleset to require merge-approval,
# review mode needs it active next to a review ruleset with every review setting on (ruleset_approval_mode).
ruleset_named() {
  local id
  id=$(gh api "repos/$repo/rulesets?includes_parents=false" --jq ".[] | select(.name == \"$1\") | .id")
  [[ -z $id ]] || gh api "repos/$repo/rulesets/$id"
}
branch_rules=$(ruleset_named agent-guardrails)
mode=-
if [[ -n $branch_rules && $(ruleset_approval_mode <<<"$branch_rules") == status ]]; then
  mode=status
elif [[ -n $branch_rules && $(jq -r .enforcement <<<"$branch_rules") == active ]]; then
  review_rules=$(ruleset_named agent-guardrails-review)
  if [[ -n $review_rules && $(ruleset_approval_mode <<<"$review_rules") == review ]]; then mode=review; fi
fi
[[ $mode != - ]] ||
  die "the agent-guardrails rulesets on $repo are missing, inactive or changed, so an approval would not protect anything. Check the audit log, then restore them with: guardrails on $repo"

# The guard result comes from the run of the default branch's agent-guard.yml (pull_request_target), not
# from any check run named "guard": a workflow added by the PR could report a check run of that name.
guard=$(gh api "repos/$repo/actions/runs?head_sha=$sha&event=pull_request_target&per_page=100" \
  --jq '[.workflow_runs[] | select(.path == ".github/workflows/agent-guard.yml")] | sort_by(.created_at) | last | .conclusion // "missing"')
[[ $guard == success ]] || die "guard run for $sha is '$guard'; wait for it or fix the PR"

# Read in full before the loop: a failed listing or download must stop the approval, not skip the scan.
workflows=$(gh api "repos/$repo/contents/.github/workflows?ref=$sha" --jq '.[] | select(.type == "file") | .path') ||
  die "cannot list the workflows of $sha; nothing approved"
while IFS= read -r workflow; do
  [[ -n $workflow ]] || continue
  content=$(gh api "repos/$repo/contents/$workflow?ref=$sha" --jq .content) || die "cannot read $workflow at $sha; nothing approved"
  if base64 --decode <<<"$content" | grep -Ei '(checks|statuses):[[:space:]]*write|write-all' >/dev/null; then
    die "$workflow lets its token write checks or statuses (could fake a required check); refuse to approve"
  fi
done <<<"$workflows"

if [[ $mode == review && $(jq -r .author.login <<<"$pr_json") == "$(gh api user --jq .login)" ]]; then
  die "PR #$pr is your own, and GitHub does not let you approve it. Its checks passed; as a repository admin you may merge it yourself: gh pr merge $(jq -r .url <<<"$pr_json") --squash --admin"
fi

files=$(pr_files "$repo" "$pr")
# Titles are written by the agent: drop control characters so they cannot redraw the lines below.
title=$(jq -r '.title | gsub("[[:cntrl:]]"; "?")' <<<"$pr_json")
url=$(jq -r .url <<<"$pr_json")
printf '\nPR #%s %s\n%s\nhead: %s\n\nChanged files:\n' "$pr" "$title" "$url" "$sha"
workflow_changes=""
marked=""
while IFS= read -r file; do
  [[ -n $file ]] || continue
  marker="  "
  if is_human_owned "$file"; then marker="! "; fi
  case $file in .github/workflows/* | .github/actions/*)
    marker="!!"
    workflow_changes+="$file "
    ;;
  esac
  printf '%s %s\n' "$marker" "$file"
  marked+="${marker// /}"$'\t'"$file"$'\n'
done <<<"$files"
printf '\n(! human-owned, !! workflow: can change what CI enforces)\n'

short=${sha:0:7}
emit_event "$(jq -n -c --arg repo "$repo" --argjson pr "$pr" --arg url "$url" --arg title "$title" --arg sha "$sha" \
  --argjson files "$(files_json <<<"$marked")" \
  '{event: "plan", action: "approve", repo: $repo, pr: $pr, url: $url, title: $title, sha: $sha, files: $files}')"
emit_event "$(jq -n -c --arg expect "$short" '{event: "confirm", step: "commit", expect: $expect}')"
read -r -p "Type $short to approve merging exactly this commit: " typed </dev/tty
[[ $typed == "$short" ]] || die "confirmation did not match; nothing approved"
if [[ -n $workflow_changes ]]; then
  emit_event '{"event":"confirm","step":"workflows","expect":"workflows"}'
  read -r -p "Workflow files change ($workflow_changes). Type 'workflows' to confirm you reviewed them: " typed </dev/tty
  [[ $typed == workflows ]] || die "workflow confirmation missing; nothing approved"
fi

if [[ $mode == status ]]; then
  gh api -X POST "repos/$repo/statuses/$sha" -f state=success -f context=merge-approval \
    -f description="Approved by owner for PR #$pr" >/dev/null
  printf 'merge-approval: success on %s (PR #%s)\n' "$sha" "$pr"
  exit 0
fi
# The review names the commit the owner saw, so a push between showing and approving cannot receive it.
review_id=$(gh api -X POST "repos/$repo/pulls/$pr/reviews" -f commit_id="$sha" -f event=APPROVE \
  -f body="Approved by the owner for $sha after the agent-guardrails checks." --jq .id)
now=$(gh pr view "$pr" -R "$repo" --json headRefOid --jq .headRefOid)
if [[ $now != "$sha" ]]; then
  # Do not leave an approval behind on a PR that moved; GitHub's handling of it is not something to rely on.
  gh api -X PUT "repos/$repo/pulls/$pr/reviews/$review_id/dismissals" \
    -f message="The PR moved to ${now:0:7} while the owner approved ${sha:0:7}" -f event=DISMISS >/dev/null
  die "PR #$pr moved to ${now:0:7} while you approved ${sha:0:7}; your review was dismissed. Review the new head."
fi
printf 'approved %s with a GitHub review (PR #%s)\n' "$sha" "$pr"
