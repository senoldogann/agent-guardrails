#!/usr/bin/env bash
# Owner's command for the agent-guardrails kit, also installed as agent-guardrails. Run it in your own terminal
# or through the Guardrails app, never through an agent (bash-guard blocks the state-changing subcommands).
#
#   guardrails                         what waits for you (same as `guardrails inbox`; --json for the app)
#   guardrails on <bootstrap PR link>  check, merge and enforce a /guardrails-init PR
#   guardrails on <owner/repo>         enforce a repo whose default branch already carries the kit
#   guardrails off <owner/repo>        stop enforcing and remove the kit: the agent works there as before
#   guardrails approve [PR link]       approve a PR's HEAD; without a link, pick from the waiting PRs
#   guardrails revoke <PR link>        withdraw an approval
#   guardrails status                  every enforced repo: ruleset and kit files, plus this kit install
#   guardrails update                  fast-forward this kit install to its origin main, reinstall, rebuild the app
#   guardrails version                 the kit version (VERSION) and the commit of this kit install
#   guardrails agent create [--org O]  register the agent's own GitHub App (opens the browser)
#   guardrails agent status [--json]   the agent App and where it is installed (read-only)
#   guardrails projects --json         your repositories with their state (read-only, for the app)
#   guardrails prs <owner/repo> --json the open PRs of one repository (read-only, for the app)
#
# Enforced repos are listed in ~/.config/agent-guardrails/repos and carry the GitHub topic agent-guardrails.
# The global hooks treat a listed repo as a kit repo even if its local .agent/ is deleted, and from any
# directory when a command names it; the inbox raises an alarm when the list and the topics disagree.
set -euo pipefail
kit=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
source "$kit/skills/guardrails-init/template/.agent/bin/lib.sh"
source "$kit/bin/pr-target.sh"
source "$kit/bin/guardrails-lib.sh"
source "$kit/hooks-global/kit-project.sh"
source "$kit/bin/agent-app-lib.sh"

registry=$(guardrails_registry)
ruleset_name=agent-guardrails
review_ruleset_name=agent-guardrails-review
tag_ruleset_name=agent-guardrails-tags
topic=agent-guardrails
tmp_dirs=""
# shellcheck disable=SC2329,SC2317 # invoked by the EXIT trap
cleanup() {
  local d
  for d in $tmp_dirs; do rm -rf "$d"; done
}
trap cleanup EXIT

usage() {
  # The command list is the header's lines that start with "#   guardrails".
  awk '/^#   guardrails/ { sub(/^# /, ""); print }' "$0" >&2
  exit 1
}

# Dies outside the owner's own interactive shell (the agent's environment sets a GitHub token or gh config).
require_owner_shell() {
  require_owner_environment "guardrails $1"
  [[ -t 0 && -t 1 ]] || die "guardrails $1 needs an interactive terminal (typed confirmation)"
}

require_owner_terminal() {
  require_owner_shell "$1"
  require_reviewed_kit
}

# Agent-written text (titles) loses control characters before it reaches the terminal.
clean() {
  LC_ALL=C tr -d '\000-\010\013-\037\177' <<<"$1"
}

registered_repos() {
  [[ -f $registry ]] || return 0
  awk 'NF > 0' "$registry"
}

register() {
  mkdir -p "$(dirname "$registry")"
  touch "$registry"
  grep -Fxi -- "$1" "$registry" >/dev/null || printf '%s\n' "$1" >>"$registry"
}

unregister() {
  [[ -f $registry ]] || return 0
  grep -Fxiv -- "$1" "$registry" >"$registry.tmp" || true
  mv "$registry.tmp" "$registry"
}

# Prints the branch ruleset's enforcement (active, evaluate, disabled) or "missing"; dies when GitHub cannot be
# read. Argument: owner/repo.
ruleset_state() {
  ruleset_enforcement "$1" "$ruleset_name"
}

# Clones a repo into a new temporary directory at the given ref (a branch or a PR's head SHA). Always over
# HTTPS with gh as the credential helper, whatever gh's git_protocol says, so a machine without a GitHub SSH
# key works. Runs inside $(...), where `set -e` does not apply, so every step dies on its own failure.
clone_at() {
  local repo=$1 ref=$2 dir
  dir=$(mktemp -d) || die "cannot create a temporary directory"
  git -c credential.https://github.com.helper= -c "credential.https://github.com.helper=!gh auth git-credential" \
    clone --quiet --no-checkout "https://github.com/$repo.git" "$dir" || die "cannot clone $repo over HTTPS"
  git -C "$dir" config credential.https://github.com.helper ''
  git -C "$dir" config --add credential.https://github.com.helper '!gh auth git-credential'
  git -C "$dir" fetch --quiet origin "$ref" || die "cannot fetch $ref from $repo"
  git -C "$dir" checkout --quiet --detach FETCH_HEAD || die "cannot check out $ref of $repo"
  printf '%s\n' "$dir"
}

require_no_drift() {
  local drift
  drift=$(kit_drift "$1")
  [[ -z $drift ]] || die "the kit files differ from your installed kit ($kit), so they could carry changes nobody reviewed:
$drift
Update the installed kit (git -C $kit pull --ff-only) or ask the agent to redo the kit files, then try again."
}

# Dies when any workflow of the checkout could write check runs or commit statuses (and so fake a
# required check or merge-approval): pull_request runs execute the PR's code with that token.
require_no_status_rights() {
  local workflow
  for workflow in "$1"/.github/workflows/*.yml "$1"/.github/workflows/*.yaml; do
    [[ -e $workflow ]] || continue
    if grants_check_or_status_writes <"$workflow"; then
      die "${workflow#"$1"/} lets its token write checks or statuses (could fake an approval); remove that first"
    fi
  done
}

# Creates or replaces the ruleset with the given name. Arguments: owner/repo, name, ruleset JSON.
put_ruleset() {
  local repo=$1 name=$2 ruleset=$3 live
  live=$(ruleset_by_name "$repo" "$name") || exit 1
  if [[ -n $live ]]; then
    gh api -X PUT "repos/$repo/rulesets/$(jq -r .id <<<"$live")" --input - <<<"$ruleset" >/dev/null
  else
    gh api -X POST "repos/$repo/rulesets" --input - <<<"$ruleset" >/dev/null
  fi
}

# Deletes the ruleset with the given name if the repository has it. Arguments: owner/repo, name.
delete_ruleset() {
  local live
  live=$(ruleset_by_name "$1" "$2") || exit 1
  [[ -z $live ]] || gh api -X DELETE "repos/$1/rulesets/$(jq -r .id <<<"$live")" >/dev/null
}

# Succeeds when review mode applies: the agent App is installed on the repository, on selected repositories
# only and with no extra permission, and the default branch's CODEOWNERS gives every path to the owner with
# no errors GitHub reports. Fails (status mode) when the App is not registered here or not installed there.
# Dies when the App is installed but a precondition is missing, and when the lookup itself fails, so an error
# never quietly turns into status mode. Arguments: owner/repo, checkout of the default branch.
review_mode_ready() {
  local repo=$1 dir=$2 installation owner problems errors
  agent_app_registered || return 1
  installation=$(agent_installation "$repo") || die "cannot tell whether the agent App is installed on $repo; nothing changed"
  [[ -n $installation ]] || return 1
  owner=$(login) || exit 1
  problems=$({
    installation_problems <<<"$installation"
    codeowners_problems "$dir" "$owner"
  })
  errors=$(gh api "repos/$repo/codeowners/errors" --jq '.errors[] | "CODEOWNERS line \(.line): \(.message | split("\n")[0])"') ||
    die "cannot read CODEOWNERS errors of $repo from GitHub; nothing changed"
  [[ -z $problems$errors ]] || die "the agent App is installed on $repo, but review mode needs:
$problems${problems:+${errors:+$'\n'}}$errors
Fix this in a PR you author (while status mode is on: guardrails approve <PR link>), then run: guardrails on $repo"
}

# Applies the rulesets and repository settings the kit relies on. Required checks come from the
# checkout's own checks-<lang> workflows. Nobody bypasses the branch ruleset (checks, history, deletion); in
# review mode a separate review ruleset lets admins merge their own PRs without a review.
enforce() {
  local repo=$1 dir=$2 jobs checks mode
  jobs=$(check_jobs "$dir")
  [[ -n $jobs ]] || die "no checks-<lang> job found in .github/workflows/checks-*.yml"
  # ci-guard keeps PR workflows from defining jobs with these names.
  checks=$(pinned_checks "$jobs")
  if review_mode_ready "$repo" "$dir"; then
    put_ruleset "$repo" "$ruleset_name" "$(branch_ruleset "$ruleset_name" "$checks")"
    put_ruleset "$repo" "$review_ruleset_name" "$(review_ruleset "$review_ruleset_name")"
    mode="review mode: approve the agent's PRs with a GitHub review (guardrails approve, github.com or GitHub Mobile); tags: admins only"
  else
    put_ruleset "$repo" "$ruleset_name" "$(status_mode_ruleset "$ruleset_name" "$checks")"
    delete_ruleset "$repo" "$review_ruleset_name"
    mode="status mode: approve each PR's HEAD with guardrails approve (merge-approval); tags: admins, which includes the agent while it uses your login. For a team, use review mode: guardrails agent create, install the App here, then guardrails on $repo again"
  fi
  put_ruleset "$repo" "$tag_ruleset_name" "$(tag_ruleset "$tag_ruleset_name")"
  gh api -X PATCH "repos/$repo" -F allow_squash_merge=true -F allow_merge_commit=false \
    -F allow_rebase_merge=false -F allow_auto_merge=true -F delete_branch_on_merge=true >/dev/null
  gh api -X PUT "repos/$repo/actions/permissions/workflow" \
    -f default_workflow_permissions=read -F can_approve_pull_request_reviews=false >/dev/null
  gh api -X PUT "repos/$repo/actions/permissions" \
    -F enabled=true -f allowed_actions=all -F sha_pinning_required=true >/dev/null
  gh label create needs-decision -R "$repo" --force --color D93F0B \
    --description "The agent is waiting for the owner's decision" >/dev/null
  gh repo edit "$repo" --add-topic "$topic" >/dev/null
  printf 'on: %s (%s; required checks: guard %s)\n' "$repo" "$mode" "$(tr '\n' ' ' <<<"$jobs")"
}

on_pr() {
  local repo pr target pr_json sha base default_branch dir files file marker title url state marked="" extra_workflows=""
  target=$(pr_target "$1") || exit 1
  read -r repo pr <<<"$target"
  default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name)
  pr_json=$(gh pr view "$pr" -R "$repo" --json headRefOid,baseRefName,title,url,isDraft,state)
  sha=$(jq -r .headRefOid <<<"$pr_json")
  base=$(jq -r .baseRefName <<<"$pr_json")
  [[ $(jq -r .state <<<"$pr_json") == OPEN ]] || die "PR #$pr is not open"
  [[ $base == "$default_branch" ]] || die "PR #$pr targets '$base', not the default branch '$default_branch'"
  state=$(ruleset_state "$repo") || exit 1
  [[ $state == missing ]] ||
    die "$repo already has the $ruleset_name ruleset; approve kit PRs there with: guardrails approve $(jq -r .url <<<"$pr_json")"

  dir=$(clone_at "$repo" "$sha") || exit 1
  tmp_dirs+=" $dir"
  require_no_drift "$dir"
  require_no_status_rights "$dir"
  files=$(pr_files "$repo" "$pr")
  while IFS= read -r file; do
    case $file in
      .github/workflows/agent-guard.yml | .github/workflows/checks-*.yml) ;;
      .github/workflows/* | .github/actions/*) extra_workflows+="  $file"$'\n' ;;
    esac
  done <<<"$files"
  [[ -z $extra_workflows ]] ||
    die "the bootstrap PR changes workflows besides the kit's own; take them out of this PR:
$extra_workflows"

  title=$(clean "$(jq -r .title <<<"$pr_json")")
  url=$(jq -r .url <<<"$pr_json")
  printf '\nPR #%s %s\n%s\nhead: %s\n\n' "$pr" "$title" "$url" "$sha"
  printf 'Kit files (.agent/, .claude/settings.json, guard and checks workflows) match your installed kit.\n'
  printf 'The agent wrote the rest; review it (! = human-owned from now on):\n'
  while IFS= read -r file; do
    case $file in .agent/* | .claude/settings.json | .github/workflows/agent-guard.yml | .github/workflows/checks-*.yml) continue ;; esac
    marker="  "
    if is_human_owned "$file"; then marker="! "; fi
    printf '%s %s\n' "$marker" "$file"
    marked+="${marker// /}"$'\t'"$file"$'\n'
  done <<<"$files"
  printf '\n'
  emit_event "$(jq -n -c --arg repo "$repo" --argjson pr "$pr" --arg url "$url" --arg title "$title" --arg sha "$sha" \
    --argjson files "$(files_json <<<"$marked")" \
    '{event: "plan", action: "on", repo: $repo, pr: $pr, url: $url, title: $title, sha: $sha, files: $files}')"
  confirm commit "${sha:0:7}" "Type ${sha:0:7} to merge exactly this commit and turn the guardrails on: "

  # Listed before the merge, so a failure in between still shows up as an alarm in the inbox.
  register "$repo"
  trap 'printf "guardrails on stopped before merging. Retry with: guardrails on %s\n" "$1" >&2; cleanup' EXIT
  gh pr merge "$pr" -R "$repo" --squash --delete-branch --match-head-commit "$sha" >/dev/null
  printf 'merged PR #%s\n' "$pr"
  trap 'printf "guardrails on stopped after merging, before %s was fully enforced. Finish with: guardrails on %s\n" "$repo" "$repo" >&2; cleanup' EXIT
  enforce "$repo" "$dir"
  trap cleanup EXIT
  printf 'Next: ask the agent for /ticket-spec <ID>. Run guardrails to see what waits for you.\n'
}

on_repo() {
  local repo=$1 default_branch dir
  default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name)
  dir=$(clone_at "$repo" "$default_branch") || exit 1
  tmp_dirs+=" $dir"
  require_no_drift "$dir"
  require_no_status_rights "$dir"
  emit_event "$(jq -n -c --arg repo "$repo" --arg branch "$default_branch" '{event: "plan", action: "on-repo", repo: $repo, branch: $branch}')"
  confirm repo "$repo" "Kit files on $default_branch match your installed kit. Type $repo to turn the guardrails on: "
  register "$repo"
  enforce "$repo" "$dir"
}

off_repo() {
  local repo=$1 default_branch dir notes name branch=chore/remove-agent-guardrails url head file
  default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name)
  dir=$(clone_at "$repo" "$default_branch") || exit 1
  tmp_dirs+=" $dir"
  [[ -z $(git -C "$dir" ls-remote origin "refs/heads/$branch") ]] ||
    die "branch $branch already exists on $repo; nobody but this command should create it. Inspect and delete it, then try again."
  git -C "$dir" switch --quiet -c "$branch"
  notes=$(remove_kit_files "$dir")
  git -C "$dir" add -A

  printf '\nTurning off %s:\n  - delete the %s ruleset (merges no longer wait for checks or your approval)\n' "$repo" "$ruleset_name"
  printf '  - delete the %s and %s rulesets (no review required, anyone with write access can create tags)\n' \
    "$review_ruleset_name" "$tag_ruleset_name"
  printf '  - stop treating it as a kit repo on this machine and remove its %s topic\n' "$topic"
  printf '  - keep the repository settings the kit set: squash merge only, auto-merge allowed, branch deleted\n'
  printf '    on merge, read-only workflow token, actions pinned to SHAs, label needs-decision\n'
  if git -C "$dir" diff --cached --quiet; then
    printf '  - no kit files left on %s\n' "$default_branch"
  else
    printf '  - open and merge a PR on %s that removes:\n' "$default_branch"
    git -C "$dir" diff --cached --name-status | sed 's/^/      /'
    for file in AGENTS.md Makefile; do
      if git -C "$dir" diff --cached --quiet -- "$file" 2>/dev/null; then continue; fi
      [[ -e "$dir/$file" ]] || continue
      printf '\n    changes to %s:\n' "$file"
      git -C "$dir" --no-pager diff --cached --no-color -- "$file" | sed 's/^/      /'
    done
  fi
  [[ -z $notes ]] || printf '%s\n' "$notes" | sed 's/^/    note: /'
  printf '\n'
  emit_event "$(jq -n -c --arg repo "$repo" --arg branch "$default_branch" \
    --arg removed "$(git -C "$dir" diff --cached --name-status)" --arg notes "$notes" \
    '{event: "plan", action: "off", repo: $repo, branch: $branch,
      removed: ($removed | split("\n") | map(select(length > 0))), notes: ($notes | split("\n") | map(select(length > 0)))}')"
  confirm repo "$repo" "Type $repo to turn the guardrails off: "

  if ! git -C "$dir" diff --cached --quiet; then
    git -C "$dir" commit --quiet -m "chore: remove agent guardrails kit" \
      -m "The owner turned the agent guardrails off for this repository with 'guardrails off'."
    head=$(git -C "$dir" rev-parse HEAD)
    git -C "$dir" push --quiet -u origin "$branch"
  fi
  for name in "$ruleset_name" "$review_ruleset_name" "$tag_ruleset_name"; do
    delete_ruleset "$repo" "$name"
  done
  printf 'rulesets deleted\n'
  if [[ -n ${head:-} ]]; then
    url=$(cd "$dir" && gh pr create --base "$default_branch" --head "$branch" \
      --title "chore: remove agent guardrails kit" \
      --body "The owner turned the agent guardrails off with \`guardrails off\`. This removes the kit's files; specs/ stays as the record of decided requirements.")
    gh pr merge "$url" --squash --delete-branch --match-head-commit "$head" >/dev/null
    printf 'removed the kit files: %s\n' "$url"
  fi
  gh repo edit "$repo" --remove-topic "$topic" >/dev/null
  unregister "$repo"
  printf 'off: %s. Pull the default branch in your local clones so their .agent/ disappears too.\n' "$repo"
}

# Prints the tab-separated inbox items (see classify_prs) of one repo; dies when GitHub cannot list its PRs.
repo_items() {
  local prs
  prs=$(gh pr list -R "$1" --state open --limit 100 \
    --json number,title,url,isDraft,headRefOid,labels,statusCheckRollup,reviewDecision,autoMergeRequest) ||
    die "cannot list the open PRs of $1"
  classify_prs <<<"$prs"
}

login() {
  gh api user --jq .login || die "cannot read your GitHub login (gh auth status)"
}

# Repos tagged on GitHub as enforced but missing from this machine's list (the list lost an entry).
topic_alarms() {
  local owner tagged repo
  owner=$(login) || exit 1
  tagged=$(gh search repos --owner "$owner" --topic "$topic" --limit 100 --json fullName --jq '.[].fullName') ||
    die "cannot search your repositories for the $topic topic"
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    registered_repos | grep -Fxi -- "$repo" >/dev/null ||
      printf 'alarm\037%s\037\037\037%s carries the %s topic but is not in %s. If you did not remove it, restore with: guardrails on %s\n' \
        "$repo" "$repo" "$topic" "$registry" "$repo"
  done <<<"$tagged"
}

kit_install_alarm() {
  local local_sha remote_sha origin
  [[ -z $(kit_local_changes) ]] ||
    printf 'alarm\037\037\037\037the kit install at %s has local changes: on, off and approve refuse until it is clean\n' "$kit"
  local_sha=$(kit_git rev-parse HEAD)
  if ! origin=$(kit_origin 2>/dev/null); then
    printf 'alarm\037\037\037\037the kit install at %s has an origin that is not https://github.com/<owner>/<repo>: on, off and approve refuse until you fix it\n' "$kit"
  elif ! remote_sha=$(kit_remote_git ls-remote "$origin" refs/heads/main 2>/dev/null | cut -f1) || [[ -z $remote_sha ]]; then
    printf 'note\037\037\037\037could not reach the kit origin to compare the install with its main\n'
  elif [[ $local_sha != "$remote_sha" ]]; then
    # The title "update" tells the app to offer its Update button for this alarm.
    printf 'alarm\037\037\037update\037the kit install is not at its origin main: on, off and approve refuse until you update it (Update, or guardrails update)\n'
  fi
}

# Prints "turn-on" items: open /guardrails-init PRs in repos that are not enforced yet.
bootstrap_items() {
  local owner prs repo url title
  owner=$(login) || exit 1
  # Only the owner's PRs: anyone can open a PR from a branch of that name, from a fork too. `on` still compares
  # the kit files with this install before it merges anything.
  prs=$(gh search prs --owner "$owner" --author "$owner" --head chore/agent-guardrails --state open --limit 50 \
    --json url,title,repository --jq '.[] | [.repository.nameWithOwner, .url, .title] | @tsv') ||
    die "cannot search your open bootstrap PRs"
  while IFS=$'\t' read -r repo url title; do
    [[ -n $repo ]] || continue
    registered_repos | grep -Fxi -- "$repo" >/dev/null ||
      printf 'turn-on\037%s\037%s\037%s\037\n' "$repo" "$url" "$(clean "$title")"
  done <<<"$prs"
}

# Prints the live rulesets of a repository as {branch, review, tag} for ruleset_problems (null when missing).
# Dies when GitHub cannot be read.
live_rulesets() {
  local branch review tag
  branch=$(ruleset_by_name "$1" "$ruleset_name") || exit 1
  review=$(ruleset_by_name "$1" "$review_ruleset_name") || exit 1
  tag=$(ruleset_by_name "$1" "$tag_ruleset_name") || exit 1
  jq -n -c --argjson branch "${branch:-null}" --argjson review "${review:-null}" --argjson tag "${tag:-null}" \
    '{branch: $branch, review: $review, tag: $tag}'
}

# Prints everything that waits for the owner, one item per line: "<kind> <repo> <url> <title> <note>" separated
# by the ASCII unit separator (\037), so empty fields survive `read`.
# Kinds: alarm, note, repo (an enforced repo; note = its ruleset state), answer, approve, wait, blocked
# (see classify_prs) and turn-on (a /guardrails-init PR in a repo that is not enforced yet). PR items carry a
# sixth field, the PR's HEAD SHA, so the app notifies again when a push changes a PR that waits.
# Dies when GitHub cannot be read: an unreachable GitHub must not look like an empty inbox.
inbox_items() {
  local repo state rulesets items kind url title note sha problem
  kit_install_alarm
  topic_alarms || exit 1
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    rulesets=$(live_rulesets "$repo") || exit 1
    state=$(jq -r '.branch.enforcement // "missing"' <<<"$rulesets")
    printf 'repo\037%s\037\037\037%s\n' "$repo" "$state"
    while IFS= read -r problem; do
      [[ -n $problem ]] || continue
      printf 'alarm\037%s\037\037\037%s: %s. If you did not change it, check the audit log; restore with: guardrails on %s\n' \
        "$repo" "$repo" "$problem" "$repo"
    done < <(ruleset_problems <<<"$rulesets")
    items=$(repo_items "$repo") || exit 1
    while IFS=$'\t' read -r kind url title note sha; do
      [[ -n $kind ]] || continue
      printf '%s\037%s\037%s\037%s\037%s\037%s\n' "$kind" "$repo" "$url" "$title" "$note" "$sha"
    done <<<"$items"
  done < <(registered_repos)
  bootstrap_items || exit 1
}

# One JSON object per line with the fields of inbox_items, for the Guardrails app.
inbox_json() {
  local items
  items=$(inbox_items) || exit 1
  [[ -z $items ]] ||
    jq -R -c 'split("\u001f") | {kind: .[0], repo: .[1], url: .[2], title: .[3], note: .[4], sha: (.[5] // "")}' <<<"$items"
}

inbox() {
  local items kind repo url title note sha current="" any=0 turn_on=""
  items=$(inbox_items) || exit 1
  while IFS=$'\037' read -r kind repo url title note sha; do
    case $kind in
      alarm) printf 'ALARM  %s\n' "$note" ;;
      note) printf 'note   %s\n' "$note" ;;
    esac
  done <<<"$items"
  while IFS=$'\037' read -r kind repo url title note sha; do
    case $kind in
      answer | approve | wait | blocked)
        any=1
        [[ $repo == "$current" ]] || printf '\n%s\n' "$repo"
        current=$repo
        ;;
    esac
    case $kind in
      answer) printf '  answer   %s\n           %s (%s)\n' "$title" "$url" "$note" ;;
      approve) printf '  approve  %s (%s)\n           guardrails approve %s\n' "$title" "$note" "$url" ;;
      wait) printf '  wait     %s (%s)\n' "$title" "$note" ;;
      blocked) printf '  blocked  %s (%s)\n' "$title" "$note" ;;
      turn-on) turn_on+="  turn on  $title"$'\n'"           guardrails on $url"$'\n' ;;
      alarm) any=1 ;;
    esac
  done <<<"$items"
  if [[ -n $turn_on ]]; then
    any=1
    printf '\nNot enforced yet\n%s' "$turn_on"
  fi
  [[ $any -eq 1 ]] || printf 'Nothing waits for you.\n'
  [[ -s $registry ]] || printf '(no enforced repos yet: ask the agent for /guardrails-init in a project, then run guardrails on <PR link>)\n'
}

# The owner's repositories (not archived, newest push first) with what the app needs to show their state.
# 25 per page: with rulesets and PR counts a page of 100 takes GitHub 6-9 s, close to its 10 s GraphQL
# limit, and an overrun comes back as an HTML error page instead of JSON.
# shellcheck disable=SC2016 # $endCursor is a GraphQL variable, filled in by gh --paginate
projects_query='query($endCursor: String) {
  viewer {
    repositories(first: 25, after: $endCursor, ownerAffiliations: OWNER, isArchived: false,
                 orderBy: {field: PUSHED_AT, direction: DESC}) {
      pageInfo { hasNextPage endCursor }
      nodes {
        nameWithOwner isFork isPrivate pushedAt viewerPermission defaultBranchRef { name }
        repositoryTopics(first: 20) { nodes { topic { name } } }
        rulesets(first: 20) { nodes { name enforcement } }
        pullRequests(states: OPEN) { totalCount }
        bootstrap: pullRequests(states: OPEN, headRefName: "chore/agent-guardrails", first: 5) {
          nodes { url title isCrossRepository author { login } }
        }
      }
    }
  }
}'

projects_json() {
  local owner app installed
  owner=$(login)
  if agent_app_registered; then app=registered; else app=none; fi
  installed=$(agent_installed_repos) || exit 1
  graphql_with_retry 3 2 "$projects_query" '.data.viewer.repositories.nodes[]' |
    project_states "$owner" "$(registered_repos)" "$app" "$installed"
}

prs_json() {
  [[ $1 =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "not an owner/repo name: $1"
  gh pr list -R "$1" --state open --limit 100 \
    --json number,title,url,isDraft,headRefOid,labels,statusCheckRollup,reviewDecision,autoMergeRequest,author,updatedAt |
    pr_states
}

approve_pick() {
  local repo items choices="" count=0 kind url title note sha choice
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    items=$(repo_items "$repo" | awk -F'\t' '$1 == "approve"')
    while IFS=$'\t' read -r kind url title note sha; do
      [[ -n $url ]] || continue
      count=$((count + 1))
      choices+="$url"$'\n'
      printf '%3d  %s  %s (%s)\n' "$count" "$title" "$url" "$note"
    done <<<"$items"
  done < <(registered_repos)
  [[ $count -gt 0 ]] || die "no PR waits for your approval"
  read -r -p "Number of the PR to review and approve: " choice </dev/tty
  [[ $choice =~ ^[0-9]+$ && $choice -ge 1 && $choice -le $count ]] || die "no such number: $choice"
  exec "$kit/bin/approve-head" "$(sed -n "${choice}p" <<<"$choices")"
}

status() {
  local repo default_branch dir drift mode owners state tags login_name
  kit_install_alarm
  printf 'kit install: %s at %s\n' "$kit" "$(kit_git rev-parse --short HEAD)"
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name) ||
      die "cannot read the default branch of $repo"
    dir=$(clone_at "$repo" "$default_branch") || exit 1
    tmp_dirs+=" $dir"
    drift=$(kit_drift "$dir")
    mode=$(approval_mode "$repo") || exit 1
    state=$(ruleset_state "$repo") || exit 1
    tags=$(ruleset_enforcement "$repo" "$tag_ruleset_name") || exit 1
    printf '%-45s ruleset %-8s approval %-6s tags %-8s kit files %s\n' "$repo" "$state" "$mode" "$tags" \
      "$([[ -z $drift ]] && printf 'same as installed kit' || printf 'differ from installed kit (kit update PR needed)')"
    # A CODEOWNERS change merged after `on` could leave paths without a human code owner.
    if [[ $mode == review ]]; then
      login_name=$(login) || exit 1
      owners=$(codeowners_problems "$dir" "$login_name")
      [[ -z $owners ]] || printf '  ALARM %s\n' "${owners//$'\n'/$'\n'  ALARM }"
    fi
  done < <(registered_repos)
  [[ -s $registry ]] || printf 'no enforced repos\n'
}

# Registers the agent's GitHub App through the manifest flow (the owner clicks "Create" in the browser) and
# stores its ID and private key under agent_dir. Arguments: "" for the owner's account, or an organization.
agent_create() {
  local org=$1 dir owner url manifest code out status conversion
  dir=$(agent_dir)
  ! agent_app_registered || die "an agent App is already registered here: $(jq -r .html_url "$dir/app.json")"
  command -v python3 >/dev/null || die "python3 is needed for the browser registration flow"
  command -v openssl >/dev/null || die "openssl is needed to sign the App's tokens"
  if [[ -n $org ]]; then
    owner=$org
    url="https://github.com/organizations/$org/settings/apps/new"
  else
    owner=$(login)
    url="https://github.com/settings/apps/new"
  fi
  manifest=$(app_manifest "$(app_name "$owner")" "https://github.com/$owner")
  code=$(python3 -I "$kit/scripts/app-manifest-flow.py" "$manifest" "$url")
  [[ $code =~ ^[A-Za-z0-9_-]+$ ]] || die "unexpected code from the registration flow"
  # The code works once, so this call is not retried; on failure run the command again.
  out=$(curl -sS -w '\n%{http_code}' -X POST "https://api.github.com/app-manifests/$code/conversions" \
    -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28') ||
    die "cannot reach GitHub to finish the registration; run the command again"
  status=${out##*$'\n'}
  conversion=${out%$'\n'*}
  [[ $status == 201 ]] || die "GitHub answered $status when finishing the registration: $(cut -c1-400 <<<"$conversion")"
  (
    umask 077
    mkdir -p "$dir"
    jq '{id, client_id, slug, owner: .owner.login, html_url}' <<<"$conversion" >"$dir/app.json"
    jq -r .pem <<<"$conversion" >"$dir/private-key.pem"
  )
  printf 'Registered the agent App: %s\n' "$(jq -r .html_url "$dir/app.json")"
  printf 'Install it on the repositories the agent works in. Choose "Only select repositories":\n  https://github.com/apps/%s/installations/new\n' \
    "$(jq -r .slug "$dir/app.json")"
}

# Prints the agent App and, for every enforced repository, whether it is installed there safely.
agent_status() {
  local dir repo installation problems installed
  dir=$(agent_dir)
  if ! agent_app_registered; then
    printf 'no agent App registered on this machine: the agent works with your GitHub login (run guardrails agent create)\n'
    return 0
  fi
  printf 'agent App: %s (%s[bot])\n' "$(jq -r .html_url "$dir/app.json")" "$(jq -r .slug "$dir/app.json")"
  installed=$(agent_installed_repos) || exit 1
  printf 'installed on: %s\n' "$(tr '\n' ' ' <<<"$installed")"
  printf 'enforced repositories:\n'
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    installation=$(agent_installation "$repo") || exit 1
    if [[ -z $installation ]]; then
      printf '%-45s not installed: the agent uses your login here\n' "$repo"
      continue
    fi
    problems=$(installation_problems <<<"$installation")
    if [[ -z $problems ]]; then
      printf '%-45s installed\n' "$repo"
    else
      printf '%-45s installed, but:\n%s\n' "$repo" "    ${problems//$'\n'/$'\n'    }"
    fi
  done < <(registered_repos)
}

[[ $# -ge 1 ]] || set -- inbox
command=$1
shift
case $command in
  inbox)
    if [[ ${1:-} == --json ]]; then
      require_args 1 $# "guardrails inbox --json"
      inbox_json
    else
      require_args 0 $# "guardrails inbox [--json]"
      inbox
    fi
    ;;
  status)
    require_args 0 $# "guardrails status"
    status
    ;;
  agent)
    case "${1:-} ${2:-}" in
      "create ") require_owner_terminal "agent create" && agent_create "" ;;
      "create --org")
        [[ $# -eq 3 ]] || die "usage: guardrails agent create [--org <organization>]"
        require_owner_terminal "agent create"
        agent_create "$3"
        ;;
      "status ") agent_status ;;
      "status --json")
        # For the app, without network calls: whether an App is registered here and where to manage it.
        if agent_app_registered; then
          jq -c '{registered: true, slug, url: .html_url,
            installURL: "https://github.com/apps/\(.slug)/installations/new"}' "$(agent_dir)/app.json"
        else
          printf '{"registered":false}\n'
        fi
        ;;
      *) die "usage: guardrails agent create [--org <organization>] | guardrails agent status [--json]" ;;
    esac
    ;;
  update)
    require_args 0 $# "guardrails update"
    require_owner_shell update
    kit_update
    ;;
  version | --version)
    require_args 0 $# "guardrails version"
    printf 'agent-guardrails %s (%s)\n' "$(<"$kit/VERSION")" "$(kit_git rev-parse --short HEAD)"
    ;;
  projects)
    [[ $# -eq 1 && $1 == --json ]] || die "usage: guardrails projects --json"
    projects_json
    ;;
  prs)
    [[ $# -eq 2 && $2 == --json ]] || die "usage: guardrails prs <owner/repo> --json"
    prs_json "$1"
    ;;
  on)
    [[ $# -ge 1 ]] || usage
    require_owner_terminal on
    for target in "$@"; do
      if [[ $target == https://* ]]; then on_pr "$target"; else on_repo "$target"; fi
    done
    ;;
  off)
    require_args 1 $# "guardrails off <owner/repo>"
    require_owner_terminal off
    off_repo "$1"
    ;;
  approve)
    require_owner_terminal approve
    if [[ $# -eq 0 ]]; then approve_pick; else exec "$kit/bin/approve-head" "$@"; fi
    ;;
  revoke) exec "$kit/bin/revoke-head" "$@" ;;
  *) usage ;;
esac
