#!/usr/bin/env bash
# Owner's command for the agent-guardrails kit, also installed as agent-guardrails. Run it in your own terminal
# or through the Guardrails app, never through an agent (bash-guard blocks the state-changing subcommands).
#
#   guardrails                         what waits for you (same as `guardrails inbox`; --json for the app)
#   guardrails on <bootstrap PR link>  check, merge and enforce a /guardrails-init PR
#   guardrails on <owner/repo>         enforce a repo whose default branch already carries the kit
#   guardrails on <...> --merge-queue  also require GitHub's merge queue (organization repos in review mode);
#                                      a later plain `on` keeps it, --no-merge-queue removes it
#   guardrails on <...> --status-mode  allow a repo in review mode to switch to status mode (no agent App here)
#   guardrails off <owner/repo>        stop enforcing and remove the kit: the agent works there as before
#   guardrails approve [PR link]       approve a PR's HEAD; without a link, pick from the waiting PRs
#   guardrails revoke <PR link>        withdraw an approval
#   guardrails status                  every enforced repo: ruleset and kit files, plus this kit install
#   guardrails update                  fast-forward this kit install to its origin main, reinstall, rebuild the app
#   guardrails version                 the kit version (VERSION) and the commit of this kit install
#   guardrails agent create [--org O]  register the agent's own GitHub App (opens the browser)
#   guardrails agent status [--json]   the agent App and where it is installed (read-only)
#   guardrails projects --json         your repositories with their state (read-only, for the app)
#   guardrails prs <owner/repo> --json the open PRs of one repository (read-only, for the app)
#   guardrails report [owner/repo] [--days N] [--json]
#                                      merges, approval times, failed runs, admin merges and ruleset changes
#                                      of every enforced repo (or one) over the last N days, default 30 (read-only)
#
# Enforced repos are listed in ~/.config/agent-guardrails/repos and carry the GitHub topic agent-guardrails.
# The global hooks treat a listed repo as a kit repo even if its local .agent/ is deleted, and from any
# directory when a command names it; the inbox raises an alarm when the list and the topics disagree.
set -euo pipefail
# Pathspec settings from the environment would make this command's pathspecs literal or case-blind.
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS
kit=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
source "$kit/skills/guardrails-init/template/.agent/bin/lib.sh"
source "$kit/bin/pr-target.sh"
source "$kit/bin/guardrails-lib.sh"
source "$kit/hooks-global/kit-project.sh"
source "$kit/bin/agent-app-lib.sh"

registry=$(guardrails_registry)
# The enforced repos whose owner turned the merge queue on: a plain `on` keeps it, and the inbox raises an alarm
# when the live ruleset loses it. Next to the registry, so bash-guard keeps agents out of it the same way.
queue_registry="$(dirname "$registry")/merge-queue"
# The repos this Mac enforced and did not turn off: `on` adds to it, `off` removes, and the inbox and projects
# copy every listed repo into it. A repo in it but missing from the list lost its entry without `off`: an alarm,
# whoever owns it. In an organization the topic cannot tell that, since a teammate's Mac tags repositories too.
# Next to the registry, so bash-guard keeps agents out of it the same way.
history_registry="$(dirname "$registry")/enforced-history"
ruleset_name=agent-guardrails
review_ruleset_name=agent-guardrails-review
tag_ruleset_name=agent-guardrails-tags
topic=agent-guardrails
tmp_dirs=""
# What a repository is left with when a state-changing command stops before it finishes, and the command that
# finishes it. The EXIT trap prints it after the error, so a failure or an interruption never leaves the owner to
# guess what is on; the command sets it before each step and clears it when it is done.
stop_note=""
# shellcheck disable=SC2329,SC2317 # invoked by the EXIT trap
cleanup() {
  local d
  [[ -z $stop_note ]] || printf '%s\n' "$stop_note" >&2
  for d in $tmp_dirs; do rm -rf "$d"; done
}
trap cleanup EXIT

usage() {
  # The command list is the header's lines that start with "#   guardrails".
  awk '/^#   guardrails/ { sub(/^# /, ""); print }' "$0" >&2
  exit 1
}

# Dies outside the owner's own interactive shell (the agent's environment sets a GitHub token or gh config).
require_owner_shell() {
  require_owner_environment "guardrails $1"
  [[ -t 0 && -t 1 ]] || die "guardrails $1 needs an interactive terminal (typed confirmation)"
}

require_owner_terminal() {
  require_owner_shell "$1"
  require_reviewed_kit
}

# Agent-written text (titles) loses control characters before it reaches the terminal.
clean() {
  LC_ALL=C tr -d '\000-\010\013-\037\177' <<<"$1"
}

registered_repos() {
  [[ -f $registry ]] || return 0
  awk 'NF > 0' "$registry"
}

register() {
  mkdir -p "$(dirname "$registry")"
  touch "$registry"
  grep -Fxi -- "$1" "$registry" >/dev/null || printf '%s\n' "$1" >>"$registry"
  remember "$1"
}

unregister() {
  if [[ -f $registry ]]; then
    grep -Fxiv -- "$1" "$registry" >"$registry.tmp" || true
    mv "$registry.tmp" "$registry"
  fi
  if [[ -f $history_registry ]]; then
    grep -Fxiv -- "$1" "$history_registry" >"$history_registry.tmp" || true
    mv "$history_registry.tmp" "$history_registry"
  fi
}

remembered_repos() {
  [[ -f $history_registry ]] || return 0
  awk 'NF > 0' "$history_registry"
}

remember() {
  mkdir -p "$(dirname "$history_registry")"
  touch "$history_registry"
  grep -Fxi -- "$1" "$history_registry" >/dev/null || printf '%s\n' "$1" >>"$history_registry"
}

# Copies every listed repo into the history, so repos enforced before the history existed are covered from the
# first inbox on.
remember_listed() {
  local repo
  while IFS= read -r repo; do
    remember "$repo"
  done < <(registered_repos)
}

queue_listed() {
  [[ -f $queue_registry ]] && grep -Fxi -- "$1" "$queue_registry" >/dev/null
}

list_queue() {
  mkdir -p "$(dirname "$queue_registry")"
  touch "$queue_registry"
  queue_listed "$1" || printf '%s\n' "$1" >>"$queue_registry"
}

unlist_queue() {
  [[ -f $queue_registry ]] || return 0
  grep -Fxiv -- "$1" "$queue_registry" >"$queue_registry.tmp" || true
  mv "$queue_registry.tmp" "$queue_registry"
}

# Prints "true" when `on` gives the repository the merge queue: asked for with --merge-queue (on), refused with
# --no-merge-queue (off), and otherwise (keep) kept when this Mac's list or the live branch ruleset has it, so a
# plain `on` restores a lost queue and never drops one silently. Arguments: owner/repo, on|off|keep.
merge_queue_wanted() {
  local repo=$1 choice=$2 live
  case $choice in
    on) printf 'true\n' ;;
    off) printf 'false\n' ;;
    keep)
      if queue_listed "$repo"; then
        printf 'true\n'
      else
        live=$(ruleset_by_name "$repo" "$ruleset_name") || exit 1
        ruleset_has_merge_queue <<<"$live"
      fi
      ;;
    *) die "unknown merge queue choice: $choice" ;;
  esac
}

# Dies unless a merge queue can work on the repository (see merge_queue_refusal). Arguments: owner/repo, checkout
# that review mode is judged by.
require_merge_queue_ready() {
  local repo=$1 dir=$2 owner_type mode=status refusal
  owner_type=$(gh api "repos/$repo" --jq .owner.type) || die "cannot read the owner of $repo; nothing changed"
  # Review mode is only asked about for an organization's repository: it dies on a half-ready agent App.
  if [[ $owner_type == Organization ]] && review_mode_ready "$repo" "$dir"; then mode=review; fi
  refusal=$(merge_queue_refusal "$repo" "$owner_type" "$mode")
  [[ -z $refusal ]] || die "$refusal"
}

# Prints the numbers of the PRs in the merge queue of the repository's default branch as a JSON array ([] when it
# has no queue). Dies when GitHub cannot be read. Argument: owner/repo.
queued_prs() {
  # shellcheck disable=SC2016 # $owner and $name are GraphQL variables
  gh api graphql -f owner="${1%%/*}" -f name="${1#*/}" \
    -f query='query($owner: String!, $name: String!) {
      repository(owner: $owner, name: $name) { mergeQueue { entries(first: 100) { nodes { pullRequest { number } } } } }
    }' --jq '[.data.repository.mergeQueue.entries.nodes[]?.pullRequest.number]' ||
    die "cannot read the merge queue of $1"
}

# Prints whether the branch carries the kit's security workflow: "true" or "false". Dies when GitHub cannot be read,
# so an unreadable repository never turns an alarm into a note. Arguments: owner/repo, branch.
has_security_workflow() {
  # shellcheck disable=SC2016 # $owner, $name and $expression are GraphQL variables
  gh api graphql -f owner="${1%%/*}" -f name="${1#*/}" -f expression="$2:.github/workflows/security.yml" \
    -f query='query($owner: String!, $name: String!, $expression: String!) {
      repository(owner: $owner, name: $name) { securityWorkflow: object(expression: $expression) { id } }
    }' --jq '.data.repository.securityWorkflow != null' ||
    die "cannot read the workflows of $1"
}

# Prints the branch ruleset's enforcement (active, evaluate, disabled) or "missing"; dies when GitHub cannot be
# read. Argument: owner/repo.
ruleset_state() {
  ruleset_enforcement "$1" "$ruleset_name"
}

# Fetches a repo into a new temporary directory at the given ref (a branch or a PR's head SHA). Always over HTTPS
# with gh as the credential helper, whatever gh's git_protocol says, so a machine without a GitHub SSH key works.
# The clone runs no hooks and no fsmonitor, whatever the owner's git settings say: a hooks path, a template
# directory, or hooks defined in git config (hook.<name>.command), which are read inside the new repository, where
# conditional includes (gitdir:, hasconfig:remote.*.url:, onbranch:) apply, and turned off by name before anything
# that runs hooks. The repository's contents come from whoever writes to it, and `off` commits from an index that
# hooks must not change. Runs inside $(...), where `set -e` does not apply, so every step dies on its own failure.
clone_at() {
  local repo=$1 ref=$2 dir hooks name
  dir=$(mktemp -d) || die "cannot create a temporary directory"
  git -c init.defaultBranch=main init --quiet --template= "$dir" || die "cannot create a repository in $dir"
  git -C "$dir" config core.hooksPath /dev/null || die "cannot configure the clone of $repo"
  git -C "$dir" config core.fsmonitor false || die "cannot configure the clone of $repo"
  git -C "$dir" remote add origin "https://github.com/$repo.git" || die "cannot configure the clone of $repo"
  git -C "$dir" config credential.https://github.com.helper '' || die "cannot configure the clone of $repo"
  git -C "$dir" config --add credential.https://github.com.helper '!gh auth git-credential' ||
    die "cannot configure the clone of $repo"
  hooks=$(cd "$dir" && config_hooks) || exit 1
  while IFS= read -r name; do
    [[ -z $name ]] || git -C "$dir" config "hook.$name.enabled" false || die "cannot turn off the git hook $name in the clone"
  done <<<"$hooks"
  git -C "$dir" fetch --quiet origin "$ref" || die "cannot fetch $ref from $repo"
  git -C "$dir" checkout --quiet --detach FETCH_HEAD || die "cannot check out $ref of $repo"
  printf '%s\n' "$dir"
}

# Prints the names of the hooks the git config of the current directory defines (hook.<name>.command or
# hook.<name>.event, git 2.54 and later), one per line. core.hooksPath does not reach these, so clone_at turns each
# off by name (hook.<name>.enabled). Dies when git cannot read the config; no such hook prints nothing.
config_hooks() {
  local keys status=0
  keys=$(git config --name-only --get-regexp '^hook\..*\.(command|event)$') || status=$?
  [[ $status -le 1 ]] || die "cannot read the hooks in your git config (git config exit $status)"
  [[ -z $keys ]] || sed -E 's/^hook\.(.*)\.(command|event)$/\1/' <<<"$keys" | sort -u
}

require_no_drift() {
  local drift
  drift=$(kit_drift "$1")
  [[ -z $drift ]] || die "the kit files differ from your installed kit ($kit), so they could carry changes nobody reviewed:
$drift
Update the installed kit (git -C $kit pull --ff-only) or ask the agent to redo the kit files, then try again."
}

# Creates or replaces the ruleset with the given name. Arguments: owner/repo, name, ruleset JSON.
put_ruleset() {
  local repo=$1 name=$2 ruleset=$3 live
  live=$(ruleset_by_name "$repo" "$name") || exit 1
  if [[ -n $live ]]; then
    gh api -X PUT "repos/$repo/rulesets/$(jq -r .id <<<"$live")" --input - <<<"$ruleset" >/dev/null
  else
    gh api -X POST "repos/$repo/rulesets" --input - <<<"$ruleset" >/dev/null
  fi
}

# Deletes the ruleset with the given name if the repository has it. Arguments: owner/repo, name.
delete_ruleset() {
  local live
  live=$(ruleset_by_name "$1" "$2") || exit 1
  [[ -z $live ]] || gh api -X DELETE "repos/$1/rulesets/$(jq -r .id <<<"$live")" >/dev/null
}

# Succeeds when review mode applies: the agent App is installed on the repository, on selected repositories
# only and with no extra permission, and the default branch's CODEOWNERS gives every path to the owner with
# no errors GitHub reports. Fails (status mode) when the App is not registered here or not installed there.
# Dies when the App is installed but a precondition is missing, and when the lookup itself fails, so an error
# never quietly turns into status mode. Arguments: owner/repo, checkout of the default branch.
review_mode_ready() {
  local repo=$1 dir=$2 installation owner problems errors
  agent_app_registered || return 1
  installation=$(agent_installation "$repo") || die "cannot tell whether the agent App is installed on $repo; nothing changed"
  [[ -n $installation ]] || return 1
  owner=$(login) || exit 1
  problems=$({
    installation_problems <<<"$installation"
    codeowners_problems "$dir" "$owner"
  })
  errors=$(gh api "repos/$repo/codeowners/errors" --jq '.errors[] | "CODEOWNERS line \(.line): \(.message | split("\n")[0])"') ||
    die "cannot read CODEOWNERS errors of $repo from GitHub; nothing changed"
  [[ -z $problems$errors ]] || die "the agent App is installed on $repo, but review mode needs:
$problems${problems:+${errors:+$'\n'}}$errors
Fix this in a PR you author (while status mode is on: guardrails approve <PR link>), then run: guardrails on $repo"
}

# Prints the approval mode `on` applies and whether that leaves review mode: "review false", "status false" or
# "status true". Review mode applies where it is ready (review_mode_ready). A repository whose live rulesets are in
# review mode (review_mode_rulesets) is not turned to status mode on a Mac that cannot apply review mode, since that
# deletes the review ruleset and status mode is not hostile-agent secure: only with --status-mode (second argument "true"), which the plan and the confirmation then name. --status-mode
# where review mode is ready is refused rather than ignored. Arguments: owner/repo, checkout of the default branch,
# "true" or "false".
on_mode() {
  local repo=$1 dir=$2 status_mode=$3 branch review live why
  if review_mode_ready "$repo" "$dir"; then
    [[ $status_mode != true ]] ||
      die "the agent App registered here is installed on $repo, so it is ready for review mode; --status-mode would turn that off. Run it without --status-mode, or remove the App from $repo first if you want status mode."
    printf 'review false\n'
    return 0
  fi
  branch=$(ruleset_by_name "$repo" "$ruleset_name") || exit 1
  review=$(ruleset_by_name "$repo" "$review_ruleset_name") || exit 1
  # Only an exact answer counts: a failed evaluation must not read as "not review mode", which deletes the review
  # ruleset.
  live=$(jq -n -c --argjson branch "${branch:-null}" --argjson review "${review:-null}" '{branch: $branch, review: $review}' |
    review_mode_rulesets) ||
    die "cannot tell whether the live rulesets of $repo are in review mode (jq's error is above); nothing changed"
  case $live in
    true) ;;
    false)
      printf 'status false\n'
      return 0
      ;;
    *) die "cannot tell whether the live rulesets of $repo are in review mode (the check answered '$live'); nothing changed" ;;
  esac
  if agent_app_registered; then
    why="the agent App registered on this Mac is not installed on $repo"
  else
    why="no agent App is registered on this Mac"
  fi
  [[ $status_mode == true ]] ||
    die "$repo is in review mode, but $why, so turning it on here would switch it to status mode and delete the $review_ruleset_name ruleset. Run guardrails on $repo from the Mac that holds the agent App, or register one here (guardrails agent create) and install it on $repo. To switch $repo to status mode on purpose, run: guardrails on $repo --status-mode"
  printf 'status true\n'
}

# Prints the `guardrails on` command that runs one target again with the flags the owner gave, for stop_note.
# Arguments: owner/repo or PR link, merge queue choice (on, off or keep), --status-mode given ("true" or "false").
on_command() {
  local command="guardrails on $1"
  case $2 in
    on) command+=" --merge-queue" ;;
    off) command+=" --no-merge-queue" ;;
  esac
  [[ $3 != true ]] || command+=" --status-mode"
  printf '%s\n' "$command"
}

# Applies the rulesets and repository settings the kit relies on. Required checks: guard, security and the
# checkout's own checks-<lang> workflows. Nobody bypasses the branch ruleset (checks, history, deletion); in
# review mode a separate review ruleset lets admins merge their own PRs without a review. With the merge queue
# (third argument "true", review mode only) the branch ruleset also requires it. The fourth argument is the mode the
# owner confirmed (on_mode); when review mode became ready or stopped being ready since then, nothing is changed.
# A switch between the modes puts the new mode's approval rule in place before it takes the old one away: the review
# ruleset before the branch ruleset drops merge-approval, merge-approval before the review ruleset is deleted. So a
# repository that required the owner's approval still requires it after every step, wherever a failure or an
# interruption stops this, and stop_note says which rules are on at that point and what finishes the change. A write
# GitHub was taking when the command stopped may have gone through, so the notes say "may" about that one ruleset.
# Arguments: owner/repo, checkout of the default branch, "true" or "false", "review" or "status", the command that
# runs this again (on_command).
enforce() {
  local repo=$1 dir=$2 queue=$3 planned=$4 again=$5 jobs checks mode now=status branch review halfway settled
  jobs=$(check_jobs "$dir")
  [[ -n $jobs ]] || die "no checks-<lang> job found in .github/workflows/checks-*.yml"
  # ci-guard keeps PR workflows from defining jobs with these names.
  checks=$(pinned_checks "$jobs")
  if review_mode_ready "$repo" "$dir"; then now=review; fi
  [[ $now == "$planned" ]] ||
    die "$repo is ready for $now mode now, not for the $planned mode you confirmed; nothing changed. Run guardrails on $repo again"
  # Read before anything changes, so a stop can say what the rulesets still hold.
  branch=$(ruleset_by_name "$repo" "$ruleset_name") || exit 1
  review=$(ruleset_by_name "$repo" "$review_ruleset_name") || exit 1
  settled="guardrails on stopped halfway: $repo is in $now mode, but its tag ruleset or repository settings may not be applied yet. Run again: $again"
  stop_note="guardrails on stopped before it changed the rulesets of $repo; they are as before, apart from a change GitHub may have taken as it stopped. Run again: $again"
  if [[ $now == review ]]; then
    # What the next step leaves, worked out before the write so only the write sits between the two notes.
    halfway="guardrails on stopped halfway: $repo has the $review_ruleset_name ruleset, so every merge needs a code owner's review"
    if [[ -z $branch ]]; then
      halfway+=", but it may have no $ruleset_name ruleset yet, so merges may not wait for the checks."
    elif jq -e 'any(.rules[]?; .type == "required_status_checks"
      and any(.parameters.required_status_checks[]?; .context == "merge-approval"))' <<<"$branch" >/dev/null; then
      halfway+=", and its $ruleset_name ruleset may still require merge-approval as well."
    else
      halfway+=", and its $ruleset_name ruleset may not have its new rules yet."
    fi
    put_ruleset "$repo" "$review_ruleset_name" "$(review_ruleset "$review_ruleset_name")" ||
      die "GitHub did not take the $review_ruleset_name ruleset of $repo"
    if [[ $queue == true ]]; then
      stop_note="$halfway Run again: $again. If GitHub refuses the merge queue there, turn it on without it: guardrails on $repo --no-merge-queue"
      put_ruleset "$repo" "$ruleset_name" "$(queued_branch_ruleset "$ruleset_name" "$checks")" ||
        die "GitHub did not take the $ruleset_name ruleset with the merge queue on $repo (a merge queue needs an organization repository: public, or private on GitHub Enterprise Cloud)"
      list_queue "$repo"
    else
      stop_note="$halfway Run again: $again"
      put_ruleset "$repo" "$ruleset_name" "$(branch_ruleset "$ruleset_name" "$checks")" ||
        die "GitHub did not take the $ruleset_name ruleset of $repo"
      unlist_queue "$repo"
    fi
    mode="review mode: approve the agent's PRs with a GitHub review (guardrails approve, github.com or GitHub Mobile); tags: admins only"
    [[ $queue != true ]] || mode+="; merge queue: squash, every PR green, up to 3 per group"
  else
    # require_merge_queue_ready checked this before the confirmation; review mode changed in between.
    [[ $queue != true ]] || die "the merge queue needs review mode, and $repo is no longer ready for it; run guardrails on $repo again"
    put_ruleset "$repo" "$ruleset_name" "$(status_mode_ruleset "$ruleset_name" "$checks")" ||
      die "GitHub did not take the $ruleset_name ruleset of $repo"
    stop_note=$settled
    if [[ -n $review ]]; then
      stop_note="guardrails on stopped halfway: the $ruleset_name ruleset of $repo requires merge-approval now, and its $review_ruleset_name ruleset may still be there, so merges may need both your merge-approval and a code owner's review. Run again: $again"
    fi
    unlist_queue "$repo"
    delete_ruleset "$repo" "$review_ruleset_name" || die "GitHub did not delete the $review_ruleset_name ruleset of $repo"
    mode="status mode: approve each PR's HEAD with guardrails approve (merge-approval); tags: admins, which includes the agent while it uses your login. For a team, use review mode: guardrails agent create, install the App here, then guardrails on $repo again"
  fi
  stop_note=$settled
  put_ruleset "$repo" "$tag_ruleset_name" "$(tag_ruleset "$tag_ruleset_name")" ||
    die "GitHub did not take the $tag_ruleset_name ruleset of $repo"
  gh api -X PATCH "repos/$repo" -F allow_squash_merge=true -F allow_merge_commit=false \
    -F allow_rebase_merge=false -F allow_auto_merge=true -F delete_branch_on_merge=true >/dev/null
  gh api -X PUT "repos/$repo/actions/permissions/workflow" \
    -f default_workflow_permissions=read -F can_approve_pull_request_reviews=false >/dev/null
  gh api -X PUT "repos/$repo/actions/permissions" \
    -F enabled=true -f allowed_actions=all -F sha_pinning_required=true >/dev/null
  gh label create needs-decision -R "$repo" --force --color D93F0B \
    --description "The agent is waiting for the owner's decision" >/dev/null
  gh repo edit "$repo" --add-topic "$topic" >/dev/null
  stop_note=""
  printf 'on: %s (%s; required checks: guard security %s)\n' "$repo" "$mode" "$(tr '\n' ' ' <<<"$jobs")"
}

# Arguments: PR link, merge queue choice (on, off or keep; see merge_queue_wanted), --status-mode given ("true" or
# "false"; see on_mode).
on_pr() {
  local repo pr target pr_json sha base base_sha changed_files default_branch dir files file marker title url state queue
  local marked="" extra_workflows="" mode_plan mode leaves leaving=""
  target=$(pr_target "$1") || exit 1
  read -r repo pr <<<"$target"
  default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name)
  # One read gives the head and base commits and the count of changed files together; the clone, the file list
  # and the merge all use exactly these commits (pr_snapshot_files).
  pr_json=$(gh api "repos/$repo/pulls/$pr") || die "cannot read PR #$pr of $repo"
  sha=$(jq -er '.head.sha | strings | select(test("^[0-9a-f]{40}$"))' <<<"$pr_json") ||
    die "GitHub returned no valid head commit for PR #$pr of $repo"
  base_sha=$(jq -er '.base.sha | strings | select(test("^[0-9a-f]{40}$"))' <<<"$pr_json") ||
    die "GitHub returned no valid base commit for PR #$pr of $repo"
  changed_files=$(jq -er '.changed_files | numbers' <<<"$pr_json") ||
    die "GitHub returned no count of changed files for PR #$pr of $repo"
  base=$(jq -r .base.ref <<<"$pr_json")
  [[ $(jq -r .state <<<"$pr_json") == open ]] || die "PR #$pr is not open"
  [[ $base == "$default_branch" ]] || die "PR #$pr targets '$base', not the default branch '$default_branch'"
  state=$(ruleset_state "$repo") || exit 1
  [[ $state == missing ]] ||
    die "$repo already has the $ruleset_name ruleset; approve kit PRs there with: guardrails approve $(jq -r .html_url <<<"$pr_json")"

  dir=$(clone_at "$repo" "$sha") || exit 1
  tmp_dirs+=" $dir"
  require_no_drift "$dir"
  require_no_status_rights "$dir"
  files=$(pr_snapshot_files "$repo" "$pr" "$base_sha" "$sha" "$changed_files")
  while IFS= read -r file; do
    case $file in
      .github/workflows/agent-guard.yml | .github/workflows/security.yml | .github/workflows/agent-notify.yml) ;;
      .github/workflows/checks-*.yml) ;;
      .github/workflows/* | .github/actions/*) extra_workflows+="  $file"$'\n' ;;
    esac
  done <<<"$files"
  [[ -z $extra_workflows ]] ||
    die "the bootstrap PR changes workflows besides the kit's own; take them out of this PR:
$extra_workflows"
  queue=$(merge_queue_wanted "$repo" "$2") || exit 1
  [[ $queue != true ]] || require_merge_queue_ready "$repo" "$dir"
  mode_plan=$(on_mode "$repo" "$dir" "$3") || exit 1
  read -r mode leaves <<<"$mode_plan"
  [[ $leaves != true ]] ||
    leaving="--status-mode: this switches $repo from review mode to status mode and deletes the $review_ruleset_name ruleset. "

  title=$(clean "$(jq -r .title <<<"$pr_json")")
  url=$(jq -r .html_url <<<"$pr_json")
  printf '\nPR #%s %s\n%s\nbase: %s\nhead: %s\n\n' "$pr" "$title" "$url" "$base_sha" "$sha"
  printf 'Kit files (.agent/, .claude/settings.json, .cursor/hooks.json, guard, security, notify and checks workflows) match your installed kit.\n'
  printf 'The agent wrote the rest; review it (! = human-owned from now on):\n'
  while IFS= read -r file; do
    case $file in
      .agent/* | .claude/settings.json | .cursor/hooks.json | .github/workflows/agent-guard.yml) continue ;;
      .github/workflows/security.yml | .github/workflows/agent-notify.yml | .github/workflows/checks-*.yml) continue ;;
    esac
    marker="  "
    if is_human_owned "$file"; then marker="! "; fi
    printf '%s %s\n' "$marker" "$file"
    marked+="${marker// /}"$'\t'"$file"$'\n'
  done <<<"$files"
  printf '\n'
  [[ $queue != true ]] || printf 'The default branch will also require the merge queue (squash, every PR green, up to 3 per group).\n\n'
  emit_event "$(jq -n -c --arg repo "$repo" --argjson pr "$pr" --arg url "$url" --arg title "$title" --arg sha "$sha" \
    --arg base "$base_sha" --argjson files "$(files_json <<<"$marked")" --argjson queue "$queue" \
    --arg mode "$mode" --argjson leaves "$leaves" \
    '{event: "plan", action: "on", repo: $repo, pr: $pr, url: $url, title: $title, sha: $sha, base: $base, files: $files,
      mergeQueue: $queue, mode: $mode, leavesReviewMode: $leaves}')"
  confirm commit "${sha:0:7}" "${leaving}Type ${sha:0:7} to merge exactly this commit and turn the guardrails on: "

  # Act only on what the owner saw; the merge below is pinned to the head as well.
  jq -e --arg base "$base_sha" --arg branch "$base" --arg head "$sha" \
    '.state == "open" and .base.sha == $base and .base.ref == $branch and .head.sha == $head' \
    <<<"$(gh api "repos/$repo/pulls/$pr")" >/dev/null ||
    die "PR #$pr changed while you reviewed it, or cannot be read again; nothing merged. Run the command again to review its new state."

  # Listed before the merge, so a failure in between still shows up as an alarm in the inbox.
  register "$repo"
  stop_note="guardrails on stopped before merging PR #$pr. Run again: $(on_command "$1" "$2" "$3")"
  gh pr merge "$pr" -R "$repo" --squash --delete-branch --match-head-commit "$sha" >/dev/null
  printf 'merged PR #%s\n' "$pr"
  stop_note="guardrails on stopped after merging PR #$pr, before $repo was enforced. Finish with: $(on_command "$repo" "$2" "$3")"
  enforce "$repo" "$dir" "$queue" "$mode" "$(on_command "$repo" "$2" "$3")"
  printf 'Next: ask the agent for /ticket-spec <ID>. Run guardrails to see what waits for you.\n'
}

# Arguments: owner/repo, merge queue choice (on, off or keep; see merge_queue_wanted), --status-mode given ("true"
# or "false"; see on_mode).
on_repo() {
  local repo=$1 default_branch dir queue with="" mode_plan mode leaves leaving=""
  default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name)
  dir=$(clone_at "$repo" "$default_branch") || exit 1
  tmp_dirs+=" $dir"
  require_no_drift "$dir"
  require_no_status_rights "$dir"
  queue=$(merge_queue_wanted "$repo" "$2") || exit 1
  if [[ $queue == true ]]; then
    require_merge_queue_ready "$repo" "$dir"
    with=" with the merge queue (squash, every PR green, up to 3 per group)"
  fi
  mode_plan=$(on_mode "$repo" "$dir" "$3") || exit 1
  read -r mode leaves <<<"$mode_plan"
  if [[ $leaves == true ]]; then
    leaving="--status-mode: this switches $repo from review mode to status mode and deletes the $review_ruleset_name ruleset. "
    with=" in status mode"
  fi
  emit_event "$(jq -n -c --arg repo "$repo" --arg branch "$default_branch" --argjson queue "$queue" --arg mode "$mode" \
    --argjson leaves "$leaves" \
    '{event: "plan", action: "on-repo", repo: $repo, branch: $branch, mergeQueue: $queue, mode: $mode, leavesReviewMode: $leaves}')"
  confirm repo "$repo" "Kit files on $default_branch match your installed kit. ${leaving}Type $repo to turn the guardrails on$with: "
  register "$repo"
  enforce "$repo" "$dir" "$queue" "$mode" "$(on_command "$repo" "$2" "$3")"
}

off_repo() {
  local repo=$1 default_branch dir notes name branch=chore/remove-agent-guardrails url head file tree base_tree gpgsign=""
  local -a sign
  default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name)
  dir=$(clone_at "$repo" "$default_branch") || exit 1
  tmp_dirs+=" $dir"
  [[ -z $(git -C "$dir" ls-remote origin "refs/heads/$branch") ]] ||
    die "branch $branch already exists on $repo; nobody but this command should create it. Inspect and delete it, then try again."
  # Only the index changes (remove_kit_files). Its tree is written now, so what is committed after the confirmation is
  # exactly the plan shown, whatever happens to the index or the working tree in between.
  notes=$(remove_kit_files "$dir") || exit 1
  tree=$(git -C "$dir" write-tree) || die "cannot write the planned tree of $repo"
  base_tree=$(git -C "$dir" rev-parse 'HEAD^{tree}') || die "cannot read the tree of $repo's $default_branch"

  printf '\nTurning off %s:\n  - delete the %s ruleset (merges no longer wait for checks or your approval)\n' "$repo" "$ruleset_name"
  printf '  - delete the %s and %s rulesets (no review required, anyone with write access can create tags)\n' \
    "$review_ruleset_name" "$tag_ruleset_name"
  printf '  - stop treating it as a kit repo on this machine and remove its %s topic\n' "$topic"
  printf '  - keep the repository settings the kit set: squash merge only, auto-merge allowed, branch deleted\n'
  printf '    on merge, read-only workflow token, actions pinned to SHAs, label needs-decision\n'
  if [[ $tree == "$base_tree" ]]; then
    printf '  - no kit files left on %s\n' "$default_branch"
  else
    printf '  - open and merge a PR on %s that removes:\n' "$default_branch"
    git -C "$dir" diff --cached --name-status | sed 's/^/      /'
    for file in AGENTS.md Makefile; do
      if git -C "$dir" diff --cached --quiet -- "$file" 2>/dev/null; then continue; fi
      # Edited rather than removed: the index still has it (the working tree is never changed).
      [[ -n $(git -C "$dir" ls-files -- ":(literal)$file") ]] || continue
      printf '\n    changes to %s:\n' "$file"
      git -C "$dir" --no-pager diff --cached --no-color -- "$file" | sed 's/^/      /'
    done
  fi
  [[ -z $notes ]] || printf '%s\n' "$notes" | sed 's/^/    note: /'
  printf '\n'
  emit_event "$(jq -n -c --arg repo "$repo" --arg branch "$default_branch" \
    --arg removed "$(git -C "$dir" diff --cached --name-status)" --arg notes "$notes" \
    '{event: "plan", action: "off", repo: $repo, branch: $branch,
      removed: ($removed | split("\n") | map(select(length > 0))), notes: ($notes | split("\n") | map(select(length > 0)))}')"
  confirm repo "$repo" "Type $repo to turn the guardrails off: "

  if [[ $tree != "$base_tree" ]]; then
    # commit-tree runs no hooks and commits the planned tree itself, not whatever the index holds by now. It does not
    # read commit.gpgSign, so an owner who signs commits (and may push only signed ones) gets -S as with git commit.
    sign=()
    gpgsign=$(git -C "$dir" config --type=bool --get commit.gpgsign) || [[ $? -eq 1 ]] ||
      die "commit.gpgSign in your git config is not true or false; nothing changed on $repo"
    [[ $gpgsign != true ]] || sign=(-S)
    head=$(git -C "$dir" commit-tree ${sign[@]+"${sign[@]}"} "$tree" -p HEAD -m "chore: remove agent guardrails kit" \
      -m "The owner turned the agent guardrails off for this repository with 'guardrails off'.") ||
      die "cannot commit the removal; nothing changed on $repo"
    git -C "$dir" push --quiet origin "$head:refs/heads/$branch" || die "cannot push $branch to $repo; nothing else changed"
  fi
  for name in "$ruleset_name" "$review_ruleset_name" "$tag_ruleset_name"; do
    delete_ruleset "$repo" "$name"
  done
  printf 'rulesets deleted\n'
  if [[ -n ${head:-} ]]; then
    url=$(gh pr create -R "$repo" --base "$default_branch" --head "$branch" \
      --title "chore: remove agent guardrails kit" \
      --body "The owner turned the agent guardrails off with \`guardrails off\`. This removes the kit's files; specs/ stays as the record of decided requirements.")
    gh pr merge "$url" --squash --delete-branch --match-head-commit "$head" >/dev/null
    printf 'removed the kit files: %s\n' "$url"
  fi
  gh repo edit "$repo" --remove-topic "$topic" >/dev/null
  unregister "$repo"
  unlist_queue "$repo"
  printf 'off: %s. Pull the default branch in your local clones so their .agent/ disappears too.\n' "$repo"
}

# Prints the tab-separated inbox items (see classify_prs) of one repo; dies when GitHub cannot list its PRs.
# Arguments: owner/repo, the numbers of its queued PRs (JSON array, see queued_prs).
repo_items() {
  local prs
  prs=$(gh pr list -R "$1" --state open --limit 100 \
    --json number,title,url,isDraft,headRefOid,labels,statusCheckRollup,reviewDecision,autoMergeRequest) ||
    die "cannot list the open PRs of $1"
  classify_prs "$2" <<<"$prs"
}

login() {
  gh api user --jq .login || die "cannot read your GitHub login (gh auth status)"
}

# Prints the answer to kit_search_query (its data, one line): the owner's repositories that carry the kit's topic
# and the owner's open bootstrap PRs. Dies when the answer lacks a node list or holds fewer nodes than its total
# (kit_search_problem). Argument: the owner's login.
kit_search() {
  local answer problem
  answer=$(graphql_with_retry 3 2 "$(kit_search_query "$1" "$topic")" '.data') || exit 1
  problem=$(kit_search_problem <<<"$answer") || die "cannot read GitHub's search answer (jq's error is above): ${answer:0:300}"
  [[ -z $problem ]] || die "$problem"
  printf '%s\n' "$answer"
}

# Repos this Mac enforced that are missing from its list (the list lost an entry), see unlisted_alarms.
# Argument: kit_search's answer.
topic_alarms() {
  local alarms repo reason
  alarms=$(unlisted_alarms "$(registered_repos)" "$(remembered_repos)" <<<"$1") ||
    die "cannot compare the topic search and the history with $registry (jq's error is above)"
  while IFS=$'\t' read -r repo reason; do
    [[ -n $repo ]] || continue
    if [[ $reason == topic ]]; then
      printf 'alarm\037%s\037\037\037%s carries the %s topic but is not in %s. If you did not remove it, restore with: guardrails on %s\n' \
        "$repo" "$repo" "$topic" "$registry" "$repo"
    else
      printf 'alarm\037%s\037\037\037%s was enforced from this Mac but is not in %s, and guardrails off did not remove it. If you did not remove it, restore with: guardrails on %s\n' \
        "$repo" "$repo" "$registry" "$repo"
    fi
  done <<<"$alarms"
}

kit_install_alarm() {
  local local_sha remote_sha origin
  [[ -z $(kit_local_changes) ]] ||
    printf 'alarm\037\037\037\037the kit install at %s has local changes: on, off and approve refuse until it is clean\n' "$kit"
  local_sha=$(kit_git rev-parse HEAD)
  if ! origin=$(kit_origin 2>/dev/null); then
    printf 'alarm\037\037\037\037the kit install at %s has an origin that is not https://github.com/<owner>/<repo>: on, off and approve refuse until you fix it\n' "$kit"
  elif ! remote_sha=$(kit_remote_git ls-remote "$origin" refs/heads/main 2>/dev/null | cut -f1) || [[ -z $remote_sha ]]; then
    printf 'note\037\037\037\037could not reach the kit origin to compare the install with its main\n'
  elif [[ $local_sha != "$remote_sha" ]]; then
    # The title "update" tells the app to offer its Update button for this alarm.
    printf 'alarm\037\037\037update\037the kit install is not at its origin main: on, off and approve refuse until you update it (Update, or guardrails update)\n'
  fi
}

# Prints "turn-on" items: the open /guardrails-init PRs of the owner, in a repository of any owner, that the owner
# can turn on (bootstrap_turn_on). `on` still compares the kit files with this install before it merges anything.
# Arguments: the owner's login, kit_search's answer.
bootstrap_items() {
  local prs repo url title
  prs=$(bootstrap_turn_on "$1" "$(registered_repos)" <<<"$2") ||
    die "cannot read the bootstrap PR search's answer (jq's error is above)"
  while IFS=$'\t' read -r repo url title; do
    [[ -n $repo ]] || continue
    printf 'turn-on\037%s\037%s\037%s\037\n' "$repo" "$url" "$(clean "$title")"
  done <<<"$prs"
}

# Prints the live rulesets of a repository as {branch, review, tag} (null when missing) for ruleset_problems,
# with mergeQueue: whether the owner turned the merge queue on for it (this Mac's list), and defaultBranch: the
# branch the rulesets must cover. Dies when GitHub cannot be read.
live_rulesets() {
  local branch review tag default_branch queue=false
  branch=$(ruleset_by_name "$1" "$ruleset_name") || exit 1
  review=$(ruleset_by_name "$1" "$review_ruleset_name") || exit 1
  tag=$(ruleset_by_name "$1" "$tag_ruleset_name") || exit 1
  default_branch=$(gh api "repos/$1" --jq .default_branch) || die "cannot read the default branch of $1"
  [[ -n $default_branch ]] || die "GitHub returned no default branch for $1"
  if queue_listed "$1"; then queue=true; fi
  jq -n -c --argjson branch "${branch:-null}" --argjson review "${review:-null}" --argjson tag "${tag:-null}" \
    --argjson queue "$queue" --arg default_branch "$default_branch" \
    '{branch: $branch, review: $review, tag: $tag, mergeQueue: $queue, defaultBranch: $default_branch}'
}

# Prints everything that waits for the owner, one item per line: "<kind> <repo> <url> <title> <note>" separated
# by the ASCII unit separator (\037), so empty fields survive `read`.
# Kinds: alarm, note, repo (an enforced repo; note = its ruleset state), answer, approve, wait, blocked
# (see classify_prs) and turn-on (a /guardrails-init PR in a repo that is not enforced yet). PR items carry a
# sixth field, the PR's HEAD SHA, so the app notifies again when a push changes a PR that waits.
# Dies when GitHub cannot be read: an unreachable GitHub must not look like an empty inbox.
inbox_items() {
  local repo state rulesets problems items kind url title note sha problem queued owner search security_workflow
  kit_install_alarm
  remember_listed
  owner=$(login) || exit 1
  search=$(kit_search "$owner") || exit 1
  topic_alarms "$search" || exit 1
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    rulesets=$(live_rulesets "$repo") || exit 1
    queued='[]'
    # Only a repository whose branch ruleset requires the queue can have PRs in it: one more call only there.
    if [[ $(jq -c .branch <<<"$rulesets" | ruleset_has_merge_queue) == true ]]; then
      queued=$(queued_prs "$repo") || exit 1
    fi
    state=$(jq -r '.branch.enforcement // "missing"' <<<"$rulesets")
    printf 'repo\037%s\037\037\037%s\n' "$repo" "$state"
    # Read in full first: a failed evaluation inside a process substitution would read as "no problems".
    problems=$(ruleset_problems <<<"$rulesets") || die "cannot evaluate the live rulesets of $repo (jq's error is above)"
    while IFS= read -r problem; do
      [[ -n $problem ]] || continue
      # Without the security workflow on its default branch the repository is behind the kit, not tampered with:
      # the ruleset cannot require a check that never runs. Once the workflow is there, a missing check is an alarm.
      if [[ $problem == "$security_not_required" ]]; then
        security_workflow=$(has_security_workflow "$repo" "$(jq -r .defaultBranch <<<"$rulesets")") || exit 1
        if [[ $security_workflow == false ]]; then
          printf 'note\037%s\037\037\037%s needs the kit update: its default branch has no security workflow yet, so the ruleset cannot require the security check. Open the kit update PR (README, "Updating a project'"'"'s kit files"), approve it, then run: guardrails on %s\n' \
            "$repo" "$repo" "$repo"
          continue
        fi
      fi
      printf 'alarm\037%s\037\037\037%s: %s. If you did not change it, check the audit log; restore with: guardrails on %s\n' \
        "$repo" "$repo" "$problem" "$repo"
    done <<<"$problems"
    items=$(repo_items "$repo" "$queued") || exit 1
    while IFS=$'\t' read -r kind url title note sha; do
      [[ -n $kind ]] || continue
      printf '%s\037%s\037%s\037%s\037%s\037%s\n' "$kind" "$repo" "$url" "$title" "$note" "$sha"
    done <<<"$items"
  done < <(registered_repos)
  bootstrap_items "$owner" "$search" || exit 1
}

# One JSON object per line with the fields of inbox_items, for the Guardrails app.
inbox_json() {
  local items
  items=$(inbox_items) || exit 1
  [[ -z $items ]] ||
    jq -R -c 'split("\u001f") | {kind: .[0], repo: .[1], url: .[2], title: .[3], note: .[4], sha: (.[5] // "")}' <<<"$items"
}

inbox() {
  local items kind repo url title note sha current="" any=0 turn_on=""
  items=$(inbox_items) || exit 1
  while IFS=$'\037' read -r kind repo url title note sha; do
    case $kind in
      alarm) printf 'ALARM  %s\n' "$note" ;;
      note) printf 'note   %s\n' "$note" ;;
    esac
  done <<<"$items"
  while IFS=$'\037' read -r kind repo url title note sha; do
    case $kind in
      answer | approve | wait | blocked)
        any=1
        [[ $repo == "$current" ]] || printf '\n%s\n' "$repo"
        current=$repo
        ;;
    esac
    case $kind in
      answer) printf '  answer   %s\n           %s (%s)\n' "$title" "$url" "$note" ;;
      approve) printf '  approve  %s (%s)\n           guardrails approve %s\n' "$title" "$note" "$url" ;;
      wait) printf '  wait     %s (%s)\n' "$title" "$note" ;;
      blocked) printf '  blocked  %s (%s)\n' "$title" "$note" ;;
      turn-on) turn_on+="  turn on  $title"$'\n'"           guardrails on $url"$'\n' ;;
      alarm) any=1 ;;
    esac
  done <<<"$items"
  if [[ -n $turn_on ]]; then
    any=1
    printf '\nNot enforced yet\n%s' "$turn_on"
  fi
  [[ $any -eq 1 ]] || printf 'Nothing waits for you.\n'
  [[ -s $registry ]] || printf '(no enforced repos yet: ask the agent for /guardrails-init in a project, then run guardrails on <PR link>)\n'
}

# The owner's repositories (not archived, newest push first) with what the app needs to show their state.
# 25 per page: with rulesets and PR counts a page of 100 takes GitHub 6-9 s, close to its 10 s GraphQL
# limit, and an overrun comes back as an HTML error page instead of JSON.
# The fields of one repository that project_states reads.
project_fields='nameWithOwner isFork isPrivate pushedAt viewerPermission defaultBranchRef { name }
        owner { __typename }
        repositoryTopics(first: 20) { nodes { topic { name } } }
        rulesets(first: 20) { nodes { name enforcement rules(first: 20) { nodes { type } } } }
        pullRequests(states: OPEN) { totalCount }
        bootstrap: pullRequests(states: OPEN, headRefName: "chore/agent-guardrails", first: 5) {
          nodes { url title isCrossRepository author { login } }
        }'
# shellcheck disable=SC2016 # $endCursor is a GraphQL variable, filled in by gh --paginate
projects_query='query($endCursor: String) {
  viewer {
    repositories(first: 25, after: $endCursor, ownerAffiliations: OWNER, isArchived: false,
                 orderBy: {field: PUSHED_AT, direction: DESC}) {
      pageInfo { hasNextPage endCursor }
      nodes { '"$project_fields"' }
    }
  }
}'
# The 25 most recently pushed repositories of the organizations the owner belongs to: one page, never paginated.
# An organization can hold thousands of repositories, and listing them all would cost a call per 25 and fill the
# app with rows the owner never sets up. Where the kit already is (enforced, tagged, or with the owner's bootstrap
# PR) the repository is read by name whatever its age, and a repository gets pushed when its set-up starts.
organization_projects_query='query {
  viewer {
    repositories(first: 25, affiliations: [OWNER, COLLABORATOR, ORGANIZATION_MEMBER],
                 ownerAffiliations: [ORGANIZATION_MEMBER], isArchived: false,
                 orderBy: {field: PUSHED_AT, direction: DESC}) {
      nodes { '"$project_fields"' }
    }
  }
}'
# shellcheck disable=SC2016 # $owner and $name are GraphQL variables
project_query='query($owner: String!, $name: String!) { repository(owner: $owner, name: $name) { '"$project_fields"' } }'

# Prints one JSON object per repository for the app (project_states), newest push first: every repository the
# owner owns, the organizations' page (organization_projects_query) without the repositories the owner cannot
# administer there (no rulesets, so nothing to set up), and, read by name, every other repository the kit is in
# (project_extra_repos), whatever its owner and the owner's permission.
projects_json() {
  local owner app installed search personal organization listed extra repo node
  owner=$(login) || exit 1
  if agent_app_registered; then app=registered; else app=none; fi
  installed=$(agent_installed_repos) || exit 1
  remember_listed
  search=$(kit_search "$owner") || exit 1
  personal=$(graphql_with_retry 3 2 "$projects_query" '.data.viewer.repositories.nodes[]') || exit 1
  organization=$(graphql_with_retry 3 2 "$organization_projects_query" \
    '.data.viewer.repositories.nodes[] | select(.viewerPermission == "ADMIN")') || exit 1
  listed=$(printf '%s\n%s\n' "$personal" "$organization" | awk 'NF > 0')
  extra=$(project_extra_repos "$owner" "$(jq -r .nameWithOwner <<<"$listed")" "$(registered_repos)" "$(remembered_repos)" \
    <<<"$search") ||
    die "cannot read the search for the kit's repositories (jq's error is above)"
  {
    [[ -z $listed ]] || printf '%s\n' "$listed"
    # One that cannot be read (deleted, transferred, access lost) shows as an alarm instead of hiding the rest;
    # gh's error still goes to stderr.
    while IFS= read -r repo; do
      [[ -n $repo ]] || continue
      if ! node=$(gh api graphql -f owner="${repo%%/*}" -f name="${repo#*/}" -f query="$project_query" --jq .data.repository) ||
        [[ -z $node || $node == null ]]; then
        node=$(jq -n -c --arg repo "$repo" '{nameWithOwner: $repo, unreadable: true, isFork: false, isPrivate: true,
          pushedAt: "", viewerPermission: "READ", pullRequests: {totalCount: 0}}')
      fi
      printf '%s\n' "$node"
    done <<<"$extra"
  } | jq -c -s 'sort_by(.pushedAt // "") | reverse | .[]' |
    project_states "$owner" "$(registered_repos)" "$app" "$installed" "$(remembered_repos)"
}

prs_json() {
  local queued prs
  [[ $1 =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "not an owner/repo name: $1"
  queued=$(queued_prs "$1") || exit 1
  prs=$(gh pr list -R "$1" --state open --limit 100 \
    --json number,title,url,isDraft,headRefOid,labels,statusCheckRollup,reviewDecision,autoMergeRequest,author,updatedAt) ||
    die "cannot list the open PRs of $1"
  pr_states "$queued" <<<"$prs"
}

# The pull requests of one repository for a report, found by search (SEARCH is replaced with the search text):
# what pr_report reads. 10 per page with up to 50 commits and their check runs each keeps a page well inside
# GitHub's GraphQL time limit.
# shellcheck disable=SC2016 # $endCursor is a GraphQL variable, filled in by gh --paginate
report_query='query($endCursor: String) {
  search(query: SEARCH, type: ISSUE, first: 10, after: $endCursor) {
    issueCount
    pageInfo { hasNextPage endCursor }
    nodes {
      ... on PullRequest {
        number title url createdAt closedAt mergedAt headRefOid
        author { __typename login }
        mergedBy { login }
        latestOpinionatedReviews(first: 100, writersOnly: true) { nodes { author { login } } }
        timelineItems(first: 100, itemTypes: [READY_FOR_REVIEW_EVENT, PULL_REQUEST_REVIEW, REVIEW_DISMISSED_EVENT]) {
          pageInfo { hasNextPage }
          nodes {
            __typename
            ... on ReadyForReviewEvent { createdAt }
            ... on PullRequestReview { id state submittedAt commit { oid } author { login } }
            ... on ReviewDismissedEvent { previousReviewState review { id } }
          }
        }
        commits(last: 50) {
          pageInfo { hasPreviousPage }
          nodes {
            commit {
              oid
              statusCheckRollup {
                contexts(first: 50) {
                  nodes {
                    __typename
                    ... on CheckRun { databaseId name status conclusion completedAt }
                    ... on StatusContext { context state createdAt }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}'

# Prints the pull requests of a repository updated since a timestamp as one JSON array. Dies when GitHub cannot
# list them all: search lists at most 1000, and a list shorter than GitHub's count would make a report look
# better or worse than it was. Arguments: owner/repo, window start.
report_prs() {
  local repo=$1 since=$2 search pages count listed
  # A JSON string is a valid GraphQL string; the repository name is checked before it gets here.
  search=$(jq -n -c --arg q "repo:$repo is:pr updated:>=$since" '$q')
  pages=$(graphql_with_retry 3 2 "${report_query/SEARCH/$search}" '.data.search | {count: .issueCount, nodes}') || exit 1
  count=$(jq -s '.[0].count // 0' <<<"$pages")
  listed=$(jq -s '[.[].nodes[]] | length' <<<"$pages")
  [[ $count -le 1000 ]] ||
    die "$repo has $count pull requests updated in the window; GitHub search lists at most 1000. Choose fewer days."
  [[ $listed == "$count" ]] ||
    die "GitHub listed $listed of the $count pull requests of $repo updated since $since; try again"
  jq -s -c '[.[].nodes[]]' <<<"$pages"
}

# Prints the GitHub login of a user ID, or nothing for an actor that is not a user (an App, a deploy key).
# Logins are kept in actor_logins ("<id> <login>" lines) so each ID is looked up once. Arguments: ID, type.
actor_logins=""
actor_login() {
  local id=$1 type=$2 login
  [[ $type == User ]] || return 0
  login=$(awk -v id="$id" '$1 == id { print $2; exit }' <<<"$actor_logins")
  if [[ -z $login ]]; then
    login=$(gh api "user/$id" --jq .login) || die "cannot read the login of GitHub user $id"
  fi
  printf '%s\n' "$login"
}

# Prints the ruleset changes of a repository in the window as one JSON array, newest first (see ruleset_audit).
# Only rulesets that still exist have a history: a deleted ruleset's history goes with it, and the inbox raises
# an alarm for a missing kit ruleset. Arguments: owner/repo, window start.
report_ruleset_changes() {
  local repo=$1 since=$2 rulesets id name history version versions entries="" state actor_id actor_type login
  rulesets=$(gh api --paginate "repos/$repo/rulesets?includes_parents=false" --jq '.[] | [.id, .name] | @tsv') ||
    die "cannot list the rulesets of $repo"
  while IFS=$'\t' read -r id name; do
    [[ -n $id ]] || continue
    history=$(gh api --paginate "repos/$repo/rulesets/$id/history?per_page=100") ||
      die "cannot read the history of ruleset $name of $repo"
    versions=""
    for version in $(ruleset_versions_needed "$since" <<<"$history"); do
      state=$(gh api "repos/$repo/rulesets/$id/history/$version") ||
        die "cannot read version $version of ruleset $name of $repo"
      read -r actor_id actor_type < <(jq -r '"\(.actor.id) \(.actor.type)"' <<<"$state")
      login=$(actor_login "$actor_id" "$actor_type") || exit 1
      [[ -z $login ]] || actor_logins+="$actor_id $login"$'\n'
      versions+="$(jq -c --arg login "$login" '. + {login: (if $login == "" then null else $login end)}' <<<"$state")"$'\n'
    done
    [[ -z $versions ]] || entries+="$(jq -s -c . <<<"$versions" | ruleset_audit "$since" "$name")"$'\n'
  done <<<"$rulesets"
  jq -s -c 'sort_by(.time) | reverse' <<<"$entries"
}

# Prints the report of one repository as one JSON line. Arguments: owner/repo, days, window start, agent App slug.
report_repo() {
  local repo=$1 days=$2 since=$3 slug=$4 prs metrics changes
  prs=$(report_prs "$repo" "$since") || exit 1
  metrics=$(pr_report "$since" "$slug" <<<"$prs")
  changes=$(report_ruleset_changes "$repo" "$since") || exit 1
  jq -n -c --arg repo "$repo" --argjson days "$days" --arg since "$since" --argjson metrics "$metrics" \
    --argjson changes "$changes" '{repo: $repo, days: $days, since: $since} + $metrics + {rulesetChanges: $changes}'
}

# How agent work went: one report per repository (the given one, or every enforced one), read-only.
# Arguments: owner/repo or "", days, "json" or "text".
report() {
  local target=$1 days=$2 format=$3 since slug="" repos repo lines=""
  since=$(report_since "$(date +%s)" "$days")
  if agent_app_registered; then slug=$(jq -r .slug "$(agent_dir)/app.json"); fi
  if [[ -n $target ]]; then repos=$target; else repos=$(registered_repos); fi
  [[ -n $repos ]] || die "no enforced repos yet; name one: guardrails report <owner/repo>"
  # Every repository is read before anything is printed, so a failure never leaves half a report.
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    lines+="$(report_repo "$repo" "$days" "$since" "$slug")"$'\n' || exit 1
  done <<<"$repos"
  if [[ $format == json ]]; then printf '%s' "$lines"; else report_text <<<"$lines"; fi
}

approve_pick() {
  local repo items choices="" count=0 kind url title note sha choice queued
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    queued=$(queued_prs "$repo") || exit 1
    items=$(repo_items "$repo" "$queued" | awk -F'\t' '$1 == "approve"')
    while IFS=$'\t' read -r kind url title note sha; do
      [[ -n $url ]] || continue
      count=$((count + 1))
      choices+="$url"$'\n'
      printf '%3d  %s  %s (%s)\n' "$count" "$title" "$url" "$note"
    done <<<"$items"
  done < <(registered_repos)
  [[ $count -gt 0 ]] || die "no PR waits for your approval"
  read -r -p "Number of the PR to review and approve: " choice </dev/tty
  [[ $choice =~ ^[0-9]+$ && $choice -ge 1 && $choice -le $count ]] || die "no such number: $choice"
  exec "$kit/bin/approve-head" "$(sed -n "${choice}p" <<<"$choices")"
}

status() {
  local repo default_branch dir drift mode owners state tags login_name
  kit_install_alarm
  printf 'kit install: %s at %s\n' "$kit" "$(kit_git rev-parse --short HEAD)"
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    default_branch=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name) ||
      die "cannot read the default branch of $repo"
    dir=$(clone_at "$repo" "$default_branch") || exit 1
    tmp_dirs+=" $dir"
    drift=$(kit_drift "$dir")
    mode=$(approval_mode "$repo" "$default_branch") || exit 1
    state=$(ruleset_state "$repo") || exit 1
    tags=$(ruleset_enforcement "$repo" "$tag_ruleset_name") || exit 1
    printf '%-45s ruleset %-8s approval %-6s tags %-8s kit files %s\n' "$repo" "$state" "$mode" "$tags" \
      "$([[ -z $drift ]] && printf 'same as installed kit' || printf 'differ from installed kit (kit update PR needed)')"
    # A CODEOWNERS change merged after `on` could leave paths without a human code owner.
    if [[ $mode == review ]]; then
      login_name=$(login) || exit 1
      owners=$(codeowners_problems "$dir" "$login_name")
      [[ -z $owners ]] || printf '  ALARM %s\n' "${owners//$'\n'/$'\n'  ALARM }"
    fi
  done < <(registered_repos)
  [[ -s $registry ]] || printf 'no enforced repos\n'
}

# Registers the agent's GitHub App through the manifest flow (the owner clicks "Create" in the browser) and
# stores its ID and private key under agent_dir. Arguments: "" for the owner's account, or an organization.
agent_create() {
  local org=$1 dir owner url manifest code out status conversion
  dir=$(agent_dir)
  ! agent_app_registered || die "an agent App is already registered here: $(jq -r .html_url "$dir/app.json")"
  command -v python3 >/dev/null || die "python3 is needed for the browser registration flow"
  command -v openssl >/dev/null || die "openssl is needed to sign the App's tokens"
  if [[ -n $org ]]; then
    owner=$org
    url="https://github.com/organizations/$org/settings/apps/new"
  else
    owner=$(login)
    url="https://github.com/settings/apps/new"
  fi
  manifest=$(app_manifest "$(app_name "$owner")" "https://github.com/$owner")
  code=$(python3 -I "$kit/scripts/app-manifest-flow.py" "$manifest" "$url")
  [[ $code =~ ^[A-Za-z0-9_-]+$ ]] || die "unexpected code from the registration flow"
  # The code works once, so this call is not retried; on failure run the command again.
  out=$(curl -sS -w '\n%{http_code}' -X POST "https://api.github.com/app-manifests/$code/conversions" \
    -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28') ||
    die "cannot reach GitHub to finish the registration; run the command again"
  status=${out##*$'\n'}
  conversion=${out%$'\n'*}
  [[ $status == 201 ]] || die "GitHub answered $status when finishing the registration: $(cut -c1-400 <<<"$conversion")"
  (
    umask 077
    mkdir -p "$dir"
    jq '{id, client_id, slug, owner: .owner.login, html_url}' <<<"$conversion" >"$dir/app.json"
    jq -r .pem <<<"$conversion" >"$dir/private-key.pem"
  )
  printf 'Registered the agent App: %s\n' "$(jq -r .html_url "$dir/app.json")"
  printf 'Install it on the repositories the agent works in. Choose "Only select repositories":\n  https://github.com/apps/%s/installations/new\n' \
    "$(jq -r .slug "$dir/app.json")"
}

# Prints the agent App and, for every enforced repository, whether it is installed there safely.
agent_status() {
  local dir repo installation problems installed
  dir=$(agent_dir)
  if ! agent_app_registered; then
    printf 'no agent App registered on this machine: the agent works with your GitHub login (run guardrails agent create)\n'
    return 0
  fi
  printf 'agent App: %s (%s[bot])\n' "$(jq -r .html_url "$dir/app.json")" "$(jq -r .slug "$dir/app.json")"
  installed=$(agent_installed_repos) || exit 1
  printf 'installed on: %s\n' "$(tr '\n' ' ' <<<"$installed")"
  printf 'enforced repositories:\n'
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    installation=$(agent_installation "$repo") || exit 1
    if [[ -z $installation ]]; then
      printf '%-45s not installed: the agent uses your login here\n' "$repo"
      continue
    fi
    problems=$(installation_problems <<<"$installation")
    if [[ -z $problems ]]; then
      printf '%-45s installed\n' "$repo"
    else
      printf '%-45s installed, but:\n%s\n' "$repo" "    ${problems//$'\n'/$'\n'    }"
    fi
  done < <(registered_repos)
}

[[ $# -ge 1 ]] || set -- inbox
command=$1
shift
case $command in
  inbox)
    if [[ ${1:-} == --json ]]; then
      require_args 1 $# "guardrails inbox --json"
      inbox_json
    else
      require_args 0 $# "guardrails inbox [--json]"
      inbox
    fi
    ;;
  status)
    require_args 0 $# "guardrails status"
    status
    ;;
  agent)
    case "${1:-} ${2:-}" in
      "create ") require_owner_terminal "agent create" && agent_create "" ;;
      "create --org")
        [[ $# -eq 3 ]] || die "usage: guardrails agent create [--org <organization>]"
        require_owner_terminal "agent create"
        agent_create "$3"
        ;;
      "status ") agent_status ;;
      "status --json")
        # For the app, without network calls: whether an App is registered here and where to manage it.
        if agent_app_registered; then
          jq -c '{registered: true, slug, url: .html_url,
            installURL: "https://github.com/apps/\(.slug)/installations/new"}' "$(agent_dir)/app.json"
        else
          printf '{"registered":false}\n'
        fi
        ;;
      *) die "usage: guardrails agent create [--org <organization>] | guardrails agent status [--json]" ;;
    esac
    ;;
  update)
    require_args 0 $# "guardrails update"
    require_owner_shell update
    kit_update
    ;;
  version | --version)
    require_args 0 $# "guardrails version"
    printf 'agent-guardrails %s (%s)\n' "$(<"$kit/VERSION")" "$(kit_git rev-parse --short HEAD)"
    ;;
  projects)
    [[ $# -eq 1 && $1 == --json ]] || die "usage: guardrails projects --json"
    projects_json
    ;;
  prs)
    [[ $# -eq 2 && $2 == --json ]] || die "usage: guardrails prs <owner/repo> --json"
    prs_json "$1"
    ;;
  report)
    report_target="" report_days=30 report_format=text
    while [[ $# -gt 0 ]]; do
      case $1 in
        --json) report_format=json ;;
        --days)
          [[ $# -ge 2 && $2 =~ ^[1-9][0-9]{0,2}$ && $2 -le 365 ]] || die "--days takes a number of days from 1 to 365"
          report_days=$2
          shift
          ;;
        */*)
          [[ -z $report_target && $1 =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] ||
            die "usage: guardrails report [owner/repo] [--days N] [--json]"
          report_target=$1
          ;;
        *) die "usage: guardrails report [owner/repo] [--days N] [--json]" ;;
      esac
      shift
    done
    report "$report_target" "$report_days" "$report_format"
    ;;
  on)
    # --merge-queue or --no-merge-queue, anywhere, applies to every target; without either a queue is kept.
    # --status-mode lets a repository in review mode switch to status mode (on_mode).
    on_queue=keep on_targets=0 on_status_mode=false
    for target in "$@"; do
      case $target in
        --merge-queue | --no-merge-queue)
          [[ $on_queue == keep ]] || die "give --merge-queue or --no-merge-queue once"
          if [[ $target == --merge-queue ]]; then on_queue=on; else on_queue=off; fi
          ;;
        --status-mode) on_status_mode=true ;;
        -*) usage ;;
        *) on_targets=$((on_targets + 1)) ;;
      esac
    done
    [[ $on_targets -ge 1 ]] ||
      die "guardrails on needs the repository (owner/repo) or a /guardrails-init PR link, for example: guardrails on octo/app"
    [[ $on_queue != on || $on_status_mode != true ]] || die "the merge queue needs review mode; give --merge-queue or --status-mode, not both"
    require_owner_terminal on
    for target in "$@"; do
      case $target in --merge-queue | --no-merge-queue | --status-mode) continue ;; esac
      if [[ $target == https://* ]]; then
        on_pr "$target" "$on_queue" "$on_status_mode"
      else
        on_repo "$target" "$on_queue" "$on_status_mode"
      fi
    done
    ;;
  off)
    require_args 1 $# "guardrails off <owner/repo>"
    require_owner_terminal off
    off_repo "$1"
    ;;
  approve)
    require_owner_terminal approve
    if [[ $# -eq 0 ]]; then approve_pick; else exec "$kit/bin/approve-head" "$@"; fi
    ;;
  revoke) exec "$kit/bin/revoke-head" "$@" ;;
  *) usage ;;
esac
