#!/usr/bin/env bash
# Usage: revoke-head <pr-link-or-number>   (run by the HUMAN owner in their own terminal)
# Withdraws every approval the owner gave the PR's current HEAD, which blocks the merge again:
#   status mode: posts the commit status `merge-approval` = failure (the newest status of a context wins);
#   review mode: dismisses the owner's approving GitHub reviews of the PR.
set -euo pipefail
kit=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
source "$kit/skills/guardrails-init/template/.agent/bin/lib.sh"
source "$kit/bin/pr-target.sh"
require_args 1 $# "revoke-head <pr-link-or-number>"

[[ -z ${GH_TOKEN:-} && -z ${GITHUB_TOKEN:-} && -z ${GH_CONFIG_DIR:-} ]] ||
  die "GH_TOKEN, GITHUB_TOKEN or GH_CONFIG_DIR is set: this looks like the agent's environment. Run revoke-head in your own shell."

[[ -t 0 ]] || die "revoke-head needs an interactive terminal"

read -r repo pr < <(pr_target "$1")
sha=$(gh pr view "$pr" -R "$repo" --json headRefOid --jq .headRefOid)
owner=$(gh api user --jq .login)
withdrawn=0

if [[ -n $(gh api "repos/$repo/commits/$sha/statuses" --jq '.[] | select(.context == "merge-approval") | .id') ]]; then
  gh api -X POST "repos/$repo/statuses/$sha" -f state=failure -f context=merge-approval \
    -f description="Approval revoked by owner for PR #$pr" >/dev/null
  printf 'merge-approval: failure on %s (PR #%s)\n' "$sha" "$pr"
  withdrawn=1
fi

while IFS= read -r review; do
  [[ -n $review ]] || continue
  gh api -X PUT "repos/$repo/pulls/$pr/reviews/$review/dismissals" \
    -f message="Approval withdrawn by the owner" -f event=DISMISS >/dev/null
  printf 'dismissed your approving review %s (PR #%s)\n' "$review" "$pr"
  withdrawn=1
done < <(gh api --paginate "repos/$repo/pulls/$pr/reviews" \
  --jq ".[] | select(.state == \"APPROVED\" and .user.login == \"$owner\") | .id")

[[ $withdrawn -eq 1 ]] || printf 'PR #%s carries no approval of yours; nothing to withdraw\n' "$pr"
